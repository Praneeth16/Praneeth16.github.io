---
import '../../styles/home-type.css';
import '../../styles/pocket-bengaluru.css';
import districts from '../../../public/pocket-bengaluru/guide.json';
const base='/pocket-bengaluru/';
const description='Explore three illustrated Bengaluru neighbourhoods, from the flower lanes of KR Market to Cubbon Park and the Purple Line.';
---
<!doctype html><html lang="en"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Pocket Bengaluru | Praneeth Paikray</title><meta name="description" content={description}/>
<link rel="canonical" href={new URL(base,Astro.site)}/><link rel="icon" href="/favicon.svg"/>
<meta name="theme-color" content="#f9f8f2"/><meta property="og:title" content="Pocket Bengaluru"/><meta property="og:description" content={description}/><meta property="og:image" content={new URL(base+'market.webp',Astro.site)}/>
</head><body>
<header class="mast"><a class="brand" href="/">Praneeth<span>16</span></a><i></i><span>Field notes</span><a class="home" href="/">Back to home</a></header>
<main>
<header class="intro"><div><p class="kicker">An illustrated city atlas</p><h1>Pocket <em>Bengaluru.</em></h1></div><p class="deck">Follow the flowers through the old Pete, read under the trees in Cubbon Park, or catch the Purple Line above MG Road.</p></header>
<nav class="districts" aria-label="Choose a neighbourhood">{districts.map((d,i)=><a data-district={d.id} href={'#'+d.id} aria-current={i===0?'location':undefined}><img src={base+d.id+'-thumb.webp'} width="136" height="94" alt="" /><span><strong>{d.name}</strong><small>{d.sub}</small></span></a>)}</nav>
<div class="atlas"><div class="mapcol"><section class="map" aria-label="City miniature">
<div class="maphead"><strong id="map-name">KR Market</strong><span id="kannada" lang="kn">{districts[0].kannada}</span></div>
<div class="compass" aria-label="View orientation"><b>N</b><i></i></div>
<div id="viewport"><img class="poster" src={base+'market.webp'} alt="A miniature market with a clock above its red arcade, flower stalls, shopfronts and a produce yard."/><canvas tabindex="0" aria-label="Interactive city miniature. Use left and right arrows to turn, plus and minus to zoom, and Home to reset."></canvas><div class="pins"></div></div>
<div class="mapfoot"><span>Illustrated geography · distances compressed</span><button id="labels" class="enhanced" aria-pressed="true">Hide pins</button></div></section>
<div class="bar enhanced"><div class="viewbuttons"><button id="left" aria-label="Rotate left" title="Rotate left">↶</button><button id="right" aria-label="Rotate right" title="Rotate right">↷</button><i></i><button id="out" aria-label="Zoom out">−</button><output id="zoom">100%</output><button id="in" aria-label="Zoom in">+</button><i></i><button id="reset" class="word">Reset</button></div><button id="motion" class="word">Pause city</button></div>
<div class="settings enhanced"><label>Weather <select id="season"><option value="blossom">Flowering season</option><option value="rain">Monsoon shower</option><option value="dry">Dry morning</option></select></label><label>View <select id="camera"><option value="iso">Isometric</option><option value="bird">Bird’s-eye</option><option value="street">Low angle</option></select></label><label>Drag to <select id="gesture"><option value="turn">Rotate</option><option value="pan">Pan</option></select></label></div>
</div><aside class="guide"><p class="kicker">Neighbourhood field guide</p>
{districts.map(d=><section id={d.id} class="district-guide" data-guide={d.id}><h2>{d.name}</h2><p class="summary">{d.intro}</p>
<nav class="stops" aria-label={d.name+' stops'}>{d.stops.map((p,i)=><a href={'#'+p.id} data-stop={p.id}><b>{String.fromCharCode(65+i)}</b>{p.name}</a>)}</nav>
<noscript><img class="still" alt={d.name+' illustrated district'} src={base+d.id+'.webp'} /></noscript><div class="start enhanced"><button data-walk={d.id}>Start the walk</button><span>{d.stops.length} stops</span></div>
<div class="notes" aria-live="polite">{d.stops.map((p,i)=><article id={p.id} data-note={p.id}><div class="notetop"><p class="kicker">{p.type}</p><span>{i+1} / {d.stops.length}</span></div><h3>{p.name}</h3><p>{p.note}</p><p class="look"><strong>Look closely</strong>{p.look}</p>{p.source&&<a class="src" href={p.source}>Further reading</a>}
<div class="steps enhanced"><button data-prev={d.id} disabled={i===0}>Previous</button><button data-next={d.id}>{i+1===d.stops.length?'Back to overview':'Next stop'}</button></div></article>)}</div>
</section>)}</aside></div>
</main><footer><span>A city study by <a href="/">Praneeth Paikray</a></span><span>Inspired by <a href="https://april-zhu.com/pocketcity?city=amsterdam">April Zhu’s Pocket City</a></span></footer>
<script is:inline id="guide-data" type="application/json" set:html={JSON.stringify(districts).replace(/</g,'\\u003c')}></script>
<script>import '../../../public/pocket-bengaluru/explore.js';</script></body></html>
