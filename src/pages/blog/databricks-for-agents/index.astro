---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import body from '../../../generated/agents/article.html?raw';
import contents from '../../../generated/agents/contents.html?raw';
import '../../../styles/agents.css';
const deck = 'The agent platform on Databricks: execution, context, governance, evaluation, AI Runtime with NVIDIA, and serving open models. Follow the capabilities and the connections between them.';
---
<BaseLayout title="Databricks Is Databricks for Agents" description={deck} article ogImage="/agents/og.png">
  <article id="agent-article">
    <header class="article-header container">
      <h1>Databricks Is Databricks for Agents</h1>
      <p class="article-deck">{deck}</p>
      <div class="article-meta"><span>Praneeth Paikray</span><time datetime="2026-10-31">31 October 2026</time><span>15 min read · October 2026 snapshot</span></div>
      <div class="article-links"><a href="#platform-map">Explore the platform</a><a href="#open-model-serving">Serve an open model</a><a href="#air-nvidia">AIR + NVIDIA</a></div>
      <nav class="contents" aria-labelledby="contents-heading"><p class="contents-label" id="contents-heading">Contents</p><div set:html={contents}/></nav>
    </header>
    <div class="prose fit" set:html={body}/>
  </article>
  <script is:inline type="module" src="/agents/explorers.js?v=capabilities-20261101"></script>
</BaseLayout>
