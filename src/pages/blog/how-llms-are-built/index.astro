const STATE_MAP = Object.fromEntries(STATES.map(s => [s.id, s]));

/* ============================================================================
   2. OAV-STYLE HAND-DRAWN PENCIL, PASTEL & GEL PEN ENGINE
      - 4-Frame Wobble Loop: frame sequence [0, 1, 2, 1] every 180ms
      - Deterministic noise jitter so lines shimmer like hand-inked animation
   ============================================================================ */
function mulberry32(seed) {
  let a = seed >>> 0;
  return function() {
    a |= 0; a = (a + 0x6D2B79F5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

function handLine(ctx, x1, y1, x2, y2, color, width, wobbleSeed, wobbleAmp = 1.35) {
  const rng = mulberry32(wobbleSeed);
  const dist = Math.hypot(x2 - x1, y2 - y1);
  const segs = Math.max(3, Math.min(18, Math.floor(dist / 14)));
  ctx.save();
  ctx.strokeStyle = color;
  ctx.lineWidth = width;
  ctx.lineCap = "round";
  ctx.lineJoin = "round";
  // Two-pass simulated pencil/gel stroke
  for (let pass = 0; pass < 2; pass++) {
    ctx.globalAlpha = pass === 0 ? 0.92 : 0.42;
    ctx.beginPath();
    for (let i = 0; i <= segs; i++) {
      const t = i / segs;
      const env = Math.sin(Math.PI * t);
      const jx = (rng() - 0.5) * 2 * wobbleAmp * env;
      const jy = (rng() - 0.5) * 2 * wobbleAmp * env;
      const px = x1 + (x2 - x1) * t + jx;
      const py = y1 + (y2 - y1) * t + jy;
      if (i === 0) ctx.moveTo(px, py);
      else ctx.lineTo(px, py);
    }
    ctx.stroke();
  }
  ctx.restore();
}

function handCircle(ctx, cx, cy, r, strokeColor, fillColor, width, wobbleSeed, wobbleAmp = 1.2) {
  const rng = mulberry32(wobbleSeed);
  const steps = 24;
  ctx.save();
  ctx.beginPath();
  for (let i = 0; i <= steps; i++) {
    const a = (i / steps) * Math.PI * 2;
    const rad = r + (rng() - 0.5) * 2 * wobbleAmp;
    const x = cx + Math.cos(a) * rad;
    const y = cy + Math.sin(a) * rad;
    if (i === 0) ctx.moveTo(x, y);
    else ctx.lineTo(x, y);
  }
  ctx.closePath();
  if (fillColor) {
    ctx.fillStyle = fillColor;
    ctx.fill();
  }
  if (strokeColor) {
    ctx.strokeStyle = strokeColor;
    ctx.lineWidth = width;
    ctx.stroke();
  }
  ctx.restore();
}

function handRect(ctx, x, y, w, h, strokeColor, fillColor, width, wobbleSeed, wobbleAmp = 1.1) {
  const rng = mulberry32(wobbleSeed);
  ctx.save();
  if (fillColor) {
    ctx.fillStyle = fillColor;
    ctx.beginPath();
    ctx.moveTo(x + (rng()-0.5)*wobbleAmp, y + (rng()-0.5)*wobbleAmp);
    ctx.lineTo(x + w + (rng()-0.5)*wobbleAmp, y + (rng()-0.5)*wobbleAmp);
    ctx.lineTo(x + w + (rng()-0.5)*wobbleAmp, y + h + (rng()-0.5)*wobbleAmp);
    ctx.lineTo(x + (rng()-0.5)*wobbleAmp, y + h + (rng()-0.5)*wobbleAmp);
    ctx.closePath();
    ctx.fill();
  }
  if (strokeColor) {
    handLine(ctx, x, y, x + w, y, strokeColor, width, wobbleSeed + 1, wobbleAmp);
    handLine(ctx, x + w, y, x + w, y + h, strokeColor, width, wobbleSeed + 2, wobbleAmp);
    handLine(ctx, x + w, y + h, x, y + h, strokeColor, width, wobbleSeed + 3, wobbleAmp);
    handLine(ctx, x, y + h, x, y, strokeColor, width, wobbleSeed + 4, wobbleAmp);
  }
  ctx.restore();
}

function drawPaperTooth(ctx, w, h, bgColor, frameIdx) {
  ctx.fillStyle = bgColor;
  ctx.fillRect(0, 0, w, h);
  const rng = mulberry32(900 + frameIdx * 17);
  ctx.save();
  for (let i = 0; i < 65; i++) {
    const x = rng() * w;
    const y = rng() * h;
    const len = 6 + rng() * 18;
    ctx.strokeStyle = i % 2 === 0 ? "rgba(255,255,255,0.08)" : "rgba(0,0,0,0.09)";
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(x, y);
    ctx.lineTo(x + len, y + (rng() - 0.5) * 4);
    ctx.stroke();
  }
  ctx.restore();
}

/* ============================================================================
   3. BESPOKE ILLUSTRATIONS FOR ALL 16 STATES (Simulated Pencil, Pastel, Gel Pen)
   ============================================================================ */
const guards = {
  causalMask: true,
  gradClip: true,
  klLeash: true
};

function renderStateArtwork(ctx, w, h, state, frameIdx, nowSec) {
  drawPaperTooth(ctx, w, h, state.paperBg, frameIdx);
  const seedBase = (parseInt(state.num, 10) * 131) + frameIdx * 37;
  const cx = w / 2;
  const cy = h / 2;

  ctx.save();
  ctx.font = "11px 'IBM Plex Mono', monospace";

  switch (state.artType) {
    case "crawl": {
      // Funnel of noisy web documents pouring into filter sieve
      const docColors = ["#fff7e6", "#f4d393", "#e8998d", "#b5d6d6", "#e0c8f0"];
      for (let i = 0; i < 7; i++) {
        const yOff = ((nowSec * 38 + i * 24) % (h * 0.65));
        const xOff = cx - 68 + ((i * 37) % 136) + Math.sin(nowSec * 2 + i) * 6;
        handRect(ctx, xOff - 14, 10 + yOff, 28, 20, "#3a3026", docColors[i % docColors.length], 1.4, seedBase + i);
        handLine(ctx, xOff - 9, 16 + yOff, xOff + 8, 16 + yOff, "#3a3026", 1, seedBase + i + 20);
      }
      // Sieve funnel
      handLine(ctx, cx - 70, h * 0.56, cx - 22, h * 0.85, "#231e18", 2.5, seedBase + 50);
      handLine(ctx, cx + 70, h * 0.56, cx + 22, h * 0.85, "#231e18", 2.5, seedBase + 51);
      handLine(ctx, cx - 56, h * 0.66, cx + 56, h * 0.66, "#d9383a", 2.0, seedBase + 52);
      ctx.fillStyle = "#231e18";
      ctx.fillText("<html/> spam 85%", 12, h - 10);
      break;
    }

    case "dedup": {
      // Two columns of document beads with red X on duplicates and golden keep-threads
      for (let r = 0; r < 4; r++) {
        const y = 24 + r * ((h - 44) / 3.3);
        const isDup = (r === 1 || r === 3);
        handCircle(ctx, cx - 48, y, 11, "#f3ede0", isDup ? "#8c3b3b" : "#4ca686", 1.6, seedBase + r);
        handCircle(ctx, cx + 48, y, 11, "#f3ede0", isDup ? "#8c3b3b" : "#f0c86a", 1.6, seedBase + r + 10);
        handLine(ctx, cx - 34, y, cx + 34, y, isDup ? "#ff6b6b" : "#f0c86a", 1.8, seedBase + r + 20);
        if (isDup) {
          handLine(ctx, cx - 8, y - 8, cx + 8, y + 8, "#ff5a64", 2.4, seedBase + r + 30);
          handLine(ctx, cx + 8, y - 8, cx - 8, y + 8, "#ff5a64", 2.4, seedBase + r + 31);
        }
      }
      ctx.fillStyle = "#f0c86a";
      ctx.fillText("MinHash LSH", 12, h - 10);
      break;
    }

    case "bpe": {
      // Blueprint grid + BPE merge tree ("t"+"h" -> "th" -> "the")
      ctx.strokeStyle = "rgba(255,255,255,0.1)";
      ctx.lineWidth = 1;
      for (let gx = 0; gx < w; gx += 18) {
        ctx.beginPath(); ctx.moveTo(gx, 0); ctx.lineTo(gx, h); ctx.stroke();
      }
      for (let gy = 0; gy < h; gy += 18) {
        ctx.beginPath(); ctx.moveTo(0, gy); ctx.lineTo(w, gy); ctx.stroke();
      }
      const leaves = ["t", "h", "e", "_l", "l", "m"];
      leaves.forEach((ch, idx) => {
        const lx = 22 + idx * ((w - 44) / 5);
        const ly = h - 28;
        handRect(ctx, lx - 13, ly - 11, 26, 20, "#f0c86a", "#18263a", 1.4, seedBase + idx);
        ctx.fillStyle = "#fff";
        ctx.fillText(ch, lx - 6, ly + 3);
      });
      // Merge arcs
      handLine(ctx, 32, h - 40, cx - 30, 48, "#6ee7b7", 2.0, seedBase + 30);
      handLine(ctx, 64, h - 40, cx - 30, 48, "#6ee7b7", 2.0, seedBase + 31);
      handLine(ctx, cx + 10, h - 40, cx + 34, 48, "#f0c86a", 2.0, seedBase + 32);
      handRect(ctx, cx - 54, 24, 52, 24, "#6ee7b7", "#142234", 1.8, seedBase + 40);
      ctx.fillStyle = "#6ee7b7";
      ctx.fillText("#1820", cx - 47, 40);
      handRect(ctx, cx + 10, 24, 52, 24, "#f0c86a", "#142234", 1.8, seedBase + 41);
      ctx.fillStyle = "#f0c86a";
      ctx.fillText("#9941", cx + 17, 40);
      break;
    }

    case "rope": {
      // Rotating RoPE frequency dials (m * theta_i)
      const radii = [22, 42, 62];
      radii.forEach((rad, i) => {
        handCircle(ctx, cx, cy, rad, "rgba(246,236,244,0.35)", null, 1.3, seedBase + i);
        const angle = nowSec * (1.8 - i * 0.45) + i * 1.1;
        const px = cx + Math.cos(angle) * rad;
        const py = cy + Math.sin(angle) * rad;
        handLine(ctx, cx, cy, px, py, i === 0 ? "#f0c86a" : "#7ee0c6", 2.2, seedBase + i + 10);
        handCircle(ctx, px, py, 5.5, "#fff", i === 0 ? "#f0c86a" : "#e87a90", 1.5, seedBase + i + 20);
      });
      ctx.fillStyle = "#f0c86a";
      ctx.fillText("e^{i(m-n)θ}", 12, h - 10);
      break;
    }

    case "attention": {
      // 5x5 Causal Self-Attention Grid: lower triangle glowing gold/teal, upper triangle masked X
      const n = 5;
      const cell = Math.min(w, h) * 0.13;
      const startX = cx - (n * cell) / 2;
      const startY = cy - (n * cell) / 2;
      for (let r = 0; r < n; r++) {
        for (let c = 0; c < n; c++) {
          const x = startX + c * cell;
          const y = startY + r * cell;
          const masked = (c > r) && guards.causalMask;
          const pulse = 0.45 + 0.5 * Math.sin(nowSec * 3 + r * 0.9 - c * 0.7);
          const fill = masked
            ? "rgba(15, 20, 34, 0.85)"
            : `rgba(240, 200, 106, ${0.28 + 0.62 * pulse})`;
          handRect(ctx, x, y, cell - 3, cell - 3, "rgba(255,255,255,0.3)", fill, 1.1, seedBase + r * 7 + c, 0.7);
          if (masked) {
            handLine(ctx, x + 4, y + 4, x + cell - 7, y + cell - 7, "#ff6b6b", 1.2, seedBase + r * 11 + c, 0.5);
          }
        }
      }
      ctx.fillStyle = "#f0c86a";
      ctx.fillText("j ≤ i causal", 10, h - 9);
      break;
    }

    case "mask_bug": {
      // Broken causal mask: bright red arrows leaking from future column j > i back to token i
      const n = 4;
      const cell = Math.min(w, h) * 0.15;
      const startX = cx - (n * cell) / 2;
      const startY = cy - (n * cell) / 2;
      for (let r = 0; r < n; r++) {
        for (let c = 0; c < n; c++) {
          const x = startX + c * cell;
          const y = startY + r * cell;
          const isLeak = c > r;
          handRect(ctx, x, y, cell - 3, cell - 3, "#ff99a0", isLeak ? "#e72e3b" : "rgba(255,255,255,0.12)", 1.3, seedBase + r * 5 + c, 0.9);
        }
      }
      handLine(ctx, startX + 3.2 * cell, startY + 0.5 * cell, startX + 0.5 * cell, startY + 0.5 * cell, "#ffeb3b", 2.6, seedBase + 99);
      ctx.fillStyle = "#ffdce0";
      ctx.fillText("LEAK: reads t+1!", 10, h - 9);
      break;
    }

    case "moe": {
      // Router dispatching tokens into Top-2 of 6 expert boxes
      handCircle(ctx, 36, cy, 15, "#f0c86a", "#1f3329", 2.0, seedBase + 1);
      ctx.fillStyle = "#f0c86a";
      ctx.fillText("G(x)", 24, cy + 4);
      const activeA = Math.floor(nowSec * 1.5) % 5;
      const activeB = (activeA + 2) % 5;
      for (let e = 0; e < 5; e++) {
        const ey = 18 + e * ((h - 32) / 4.3);
        const ex = w - 68;
        const hot = (e === activeA || e === activeB);
        handLine(ctx, 52, cy, ex, ey + 8, hot ? "#f0c86a" : "rgba(255,255,255,0.18)", hot ? 2.4 : 1.1, seedBase + e + 10);
        handRect(ctx, ex, ey, 50, 17, hot ? "#f0c86a" : "rgba(255,255,255,0.35)", hot ? "#d97f38" : "rgba(0,0,0,0.25)", 1.4, seedBase + e + 20);
      }
      ctx.fillStyle = "#eff7f2";
      ctx.fillText("Top-2 Sparse MoE", 10, h - 9);
      break;
    }

    case "parallel": {
      // 8 GPU nodes connected in an NVLink / InfiniBand All-Reduce ring with circulating gradient pulses
      const rRing = Math.min(w, h) * 0.31;
      for (let i = 0; i < 6; i++) {
        const a1 = (i / 6) * Math.PI * 2 + nowSec * 0.4;
        const a2 = ((i + 1) / 6) * Math.PI * 2 + nowSec * 0.4;
        const x1 = cx + Math.cos(a1) * rRing, y1 = cy + Math.sin(a1) * rRing;
        const x2 = cx + Math.cos(a2) * rRing, y2 = cy + Math.sin(a2) * rRing;
        handLine(ctx, x1, y1, x2, y2, "#6ee7b7", 2.2, seedBase + i);
        handRect(ctx, x1 - 12, y1 - 9, 24, 18, "#f0c86a", "#2e3440", 1.5, seedBase + i + 20);
      }
      ctx.fillStyle = "#6ee7b7";
      ctx.fillText("Ring All-Reduce", 10, h - 9);
      break;
    }

    case "nan_bug": {
      // Exploding jagged loss curve shooting off top of chart into NaN skulls
      handLine(ctx, 18, h - 22, cx - 10, h - 38, "#ffdce0", 2.2, seedBase + 1);
      handLine(ctx, cx - 10, h - 38, cx + 18, 12, "#ffeb3b", 3.0, seedBase + 2);
      handLine(ctx, cx + 18, 12, w - 18, 28, "#ff4d4d", 2.8, seedBase + 3);
      handCircle(ctx, cx + 18, 18, 14, "#ffeb3b", "#e72e3b", 2.2, seedBase + 4);
      ctx.fillStyle = "#fff";
      ctx.fillText("NaN!", cx + 5, 22);
      ctx.fillStyle = "#ffdce0";
      ctx.fillText("non-finite numerical failure", 10, h - 9);
      break;
    }

    case "adamw": {
      // Smoothly descending loss curve with golden clipping ceiling bar
      handLine(ctx, 14, 34, w - 14, 34, "#f0c86a", 1.6, seedBase + 1);
      ctx.fillStyle = "#f0c86a";
      ctx.fillText("clip ceiling ‖g‖≤1.0", 16, 28);
      let px = 16, py = 46;
      for (let i = 1; i <= 8; i++) {
        const nx = 16 + i * ((w - 32) / 8);
        const ny = 44 + (1 - Math.exp(-i * 0.35)) * (h - 72) + Math.sin(nowSec * 3 + i) * 3;
        handLine(ctx, px, py, nx, ny, "#fff6f2", 2.4, seedBase + i + 10);
        px = nx; py = ny;
      }
      handCircle(ctx, px, py, 6, "#231e18", "#f0c86a", 1.6, seedBase + 30);
      break;
    }

    case "base_ckpt": {
      // Warm glowing neural crystal / golden monolith on ochre paper
      handRect(ctx, cx - 36, 22, 72, h - 46, "#231a0d", "#e6b86a", 2.2, seedBase + 1);
      for (let l = 0; l < 4; l++) {
        const ly = 36 + l * 18;
        handLine(ctx, cx - 24, ly, cx + 24, ly, "#231a0d", 1.5, seedBase + l + 10);
      }
      ctx.fillStyle = "#231a0d";
      ctx.fillText("15T Base Weights", 12, h - 8);
      break;
    }

    case "sft": {
      // User prompt bubble (greyed mask) -> Assistant response bubble (bright loss active)
      handRect(ctx, 16, 20, w * 0.56, 30, "#29181c", "rgba(255,255,255,0.45)", 1.5, seedBase + 1);
      ctx.fillStyle = "#5c4348";
      ctx.fillText("User: mask=0", 24, 39);
      handRect(ctx, w * 0.28, 62, w * 0.62, 36, "#29181c", "#f0c86a", 1.8, seedBase + 2);
      ctx.fillStyle = "#29181c";
      ctx.fillText("Assistant: loss ✓", w * 0.32, 84);
      break;
    }

    case "reward_bug": {
      // Policy trajectory snapping its tether and spiraling into reward-hacked stars
      handCircle(ctx, 36, h - 34, 12, "#fff", "#3c8d6d", 1.6, seedBase + 1);
      handLine(ctx, 48, h - 38, cx, cy, "#ffeb3b", 2.4, seedBase + 2);
      handLine(ctx, cx, cy, w - 26, 22, "#ff5a64", 2.8, seedBase + 3);
      ctx.fillStyle = "#ffeb3b";
      ctx.fillText("R=+9.9 gibberish!", 12, 24);
      ctx.fillStyle = "#ffdce0";
      ctx.fillText("β_KL = 0 drift", 12, h - 9);
      break;
    }

    case "grpo": {
      // Group of G=4 rollout branches scored by verifier + golden KL tether back to pi_ref
      for (let g = 0; g < 4; g++) {
        const gy = 22 + g * ((h - 44) / 3.2);
        const good = (g === 1 || g === 2);
        handLine(ctx, 26, cy, w - 58, gy, good ? "#f0c86a" : "rgba(255,255,255,0.28)", good ? 2.3 : 1.2, seedBase + g);
        handCircle(ctx, w - 46, gy, 9, "#fff", good ? "#4ca686" : "#8c3b3b", 1.4, seedBase + g + 10);
      }
      handCircle(ctx, 26, cy, 11, "#fff", "#f0c86a", 1.8, seedBase + 30);
      ctx.fillStyle = "#f1f8f4";
      ctx.fillText("GRPO + KL β=0.04", 10, h - 9);
      break;
    }

    case "kv_cache": {
      // PagedAttention KV memory blocks filling sequentially + fast single-token query
      for (let b = 0; b < 6; b++) {
        const bx = 16 + (b % 3) * 44;
        const by = 22 + Math.floor(b / 3) * 34;
        const active = b <= (Math.floor(nowSec * 2) % 6);
        handRect(ctx, bx, by, 36, 24, "#f0c86a", active ? "#3d7a9e" : "rgba(255,255,255,0.1)", 1.4, seedBase + b);
      }
      handCircle(ctx, w - 34, cy, 14, "#f0c86a", "#d97f38", 1.8, seedBase + 20);
      ctx.fillStyle = "#f0c86a";
      ctx.fillText("Paged KV cache", 10, h - 9);
      break;
    }

    case "healthy_end": {
      // Radiant connected neural star / two healthy halves in harmony
      handCircle(ctx, cx, cy - 4, 34, "#1f1b16", "#f0c86a", 2.2, seedBase + 1);
      for (let r = 0; r < 8; r++) {
        const a = (r / 8) * Math.PI * 2 + nowSec * 0.5;
        handLine(ctx, cx + Math.cos(a) * 38, cy - 4 + Math.sin(a) * 38,
                      cx + Math.cos(a) * 54, cy - 4 + Math.sin(a) * 54, "#2b7a78", 2.2, seedBase + r + 10);
      }
      ctx.fillStyle = "#1f1b16";
      ctx.fillText("✓ Grounded LLM", cx - 44, h - 8);
      break;
    }
  }
  ctx.restore();
}

/* ============================================================================
   4. BUILD THE WALL DOM, TEXT LIST, AND STEPPER CONTROLLER (step.mjs logic)
   ============================================================================ */
const wallGrid = document.getElementById("wall-grid");
const plateElements = {};
const plateCanvases = {};

function buildWallDOM() {
  wallGrid.innerHTML = "";
  PHASES.forEach(phase => {
    const banner = document.createElement("div");
    banner.className = "phase-banner";
    banner.innerHTML = `<span class="phase-title">${phase.title}</span><span class="phase-meta">${phase.meta}</span>`;
    wallGrid.appendChild(banner);

    STATES.filter(s => s.phase === phase.id).forEach(state => {
      const card = document.createElement("article");
      card.className = "plate" + (state.breaksRule ? " breaks-rule" : "");
      card.id = `plate-${state.id}`;
      card.style.backgroundColor = state.paperBg;
      card.style.color = state.paperText;
      card.setAttribute("role", "button");
      card.setAttribute("tabindex", "0");

      const stepsHtml = state.steps.map((st, idx) => {
        const target = STATE_MAP[st.to];
        return `<span class="step-chip ${st.bug ? 'bug-chip' : ''}" data-from="${state.id}" data-to="${st.to}" data-idx="${idx}" title="${st.label}">→ ${target.num} ${st.bug ? '⚡' : ''}</span>`;
      }).join("");

      card.innerHTML = `
        <div class="plate-pin"></div>
        <div>
          <div class="plate-header">
            <span class="plate-id">STATE ${state.num}</span>
            <span class="plate-tag">${state.breaksRule ? '⚡ Breaks ' + state.ruleName : state.paperTag}</span>
          </div>
          <div class="plate-canvas-wrap">
            <canvas class="plate-canvas" width="240" height="165"></canvas>
          </div>
          <h3 class="plate-title">${state.title}</h3>
          <p class="plate-caption">${state.desc}</p>
        </div>
        <div class="plate-steps-out">${stepsHtml}</div>
      `;

      card.addEventListener("click", (e) => {
        const chip = e.target.closest(".step-chip");
        if (chip) {
          e.stopPropagation();
          const toId = chip.getAttribute("data-to");
          stepToState(toId, state.id);
          return;
        }
        stepToState(state.id, currentStateId);
      });

      wallGrid.appendChild(card);
      plateElements[state.id] = card;
      plateCanvases[state.id] = card.querySelector("canvas");
    });
  });

  // Also populate "Read the Chart as Text" list in View 5
  const textList = document.getElementById("state-text-list");
  if (textList) {
    textList.innerHTML = STATES.map(s => {
      const lines = s.steps.map(st => {
        const dst = STATE_MAP[st.to];
        return `<div class="transition-line ${st.bug ? 'bug' : ''}">• ${st.label} → <strong>${dst.num} ${dst.title}</strong></div>`;
      }).join("");
      return `<div class="state-text-item">
        <strong>${s.num}. ${s.title}</strong> <span style="font-family:var(--font-mono);font-size:11px;opacity:0.75;">(${s.paperTag}${s.breaksRule ? ' · BREAKS ' + s.ruleName : ''})</span>
        ${lines}
      </div>`;
    }).join("");
  }
}

/* ============================================================================
   5. STEP-THROUGH CONTROLLER, COSINE-EASED SVG PATH ANIMATION & GLIDE SCROLL
   ============================================================================ */
let currentStateId = "s0";
let prevStateId = "s0";
let historyStack = [{ stateId: "s0", via: "initial state" }];
let autoPlayTimer = null;

// Route animation state
let routeAnim = {
  active: false,
  t0: 0,
  dur: 950,
  isBug: false
};

function getPlateCenter(stateId) {
  const stage = document.getElementById("wall-stage");
  const el = plateElements[stateId];
  if (!stage || !el) return { x: 0, y: 0, w: 0, h: 0, left: 0, top: 0 };
  const sRect = stage.getBoundingClientRect();
  const eRect = el.getBoundingClientRect();
  const left = eRect.left - sRect.left;
  const top = eRect.top - sRect.top;
  return {
    left,
    top,
    w: eRect.width,
    h: eRect.height,
    x: left + eRect.width / 2,
    y: top + eRect.height / 2
  };
}

function drawStaticWallEdges() {
  const g = document.getElementById("static-edges-group");
  if (!g) return;
  g.innerHTML = "";
  STATES.forEach(s => {
    const a = getPlateCenter(s.id);
    if (a.w === 0) return;
    s.steps.forEach(st => {
      const b = getPlateCenter(st.to);
      if (b.w === 0) return;
      const dx = b.x - a.x;
      const dy = b.y - a.y;
      const cx = (a.x + b.x) / 2 - dy * 0.12;
      const cy = (a.y + b.y) / 2 + dx * 0.08;
      const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
      path.setAttribute("d", `M ${a.x.toFixed(1)} ${a.y.toFixed(1)} Q ${cx.toFixed(1)} ${cy.toFixed(1)} ${b.x.toFixed(1)} ${b.y.toFixed(1)}`);
      path.setAttribute("fill", "none");
      path.setAttribute("stroke", st.bug ? "rgba(231, 46, 59, 0.34)" : "rgba(240, 200, 106, 0.2)");
      path.setAttribute("stroke-width", st.bug ? "2" : "1.6");
      if (st.bug) path.setAttribute("stroke-dasharray", "5 5");
      g.appendChild(path);
    });
  });
}

function updateSpotlightAndRoute(fromId, toId, isBugStep) {
  const spot = document.getElementById("step-spot");
  const targetBox = getPlateCenter(toId);
  if (spot && targetBox.w > 0) {
    spot.classList.add("visible");
    spot.classList.toggle("bug-spot", !!isBugStep || STATE_MAP[toId].breaksRule);
    spot.style.width = `${targetBox.w + 8}px`;
    spot.style.height = `${targetBox.h + 8}px`;
    spot.style.transform = `translate(${targetBox.left - 4}px, ${targetBox.top - 4}px)`;
  }

  const route = document.getElementById("step-route");
  const routeBg = document.getElementById("step-route-bg");
  const token = document.getElementById("step-token");
  if (!route || !fromId || fromId === toId) {
    if (token) token.setAttribute("opacity", "0");
    return;
  }

  const a = getPlateCenter(fromId);
  const b = getPlateCenter(toId);
  if (a.w === 0 || b.w === 0) return;

  const dx = b.x - a.x;
  const dy = b.y - a.y;
  const cx = (a.x + b.x) / 2 - dy * 0.14;
  const cy = (a.y + b.y) / 2 + dx * 0.1;
  const dStr = `M ${a.x.toFixed(1)} ${a.y.toFixed(1)} Q ${cx.toFixed(1)} ${cy.toFixed(1)} ${b.x.toFixed(1)} ${b.y.toFixed(1)}`;
  route.setAttribute("d", dStr);
  routeBg.setAttribute("d", dStr);

  const strokeCol = (isBugStep || STATE_MAP[toId].breaksRule) ? "#ff5a64" : "#f0c86a";
  route.setAttribute("stroke", strokeCol);
  route.setAttribute("marker-end", (isBugStep || STATE_MAP[toId].breaksRule) ? "url(#arrow-red)" : "url(#arrow-gold)");
  token.setAttribute("fill", strokeCol);

  const L = route.getTotalLength();
  route.style.strokeDasharray = `${L}`;
  route.style.strokeDashoffset = `${L}`;
  routeAnim = {
    active: true,
    t0: performance.now(),
    dur: Math.max(650, Math.min(1600, 420 + L * 1.8)),
    isBug: isBugStep
  };
}

function glideScrollToPlate(stateId) {
  const el = plateElements[stateId];
  if (!el) return;
  const rect = el.getBoundingClientRect();
  const targetY = window.scrollY + rect.top - (window.innerHeight * 0.28);
  const startY = window.scrollY;
  const diff = targetY - startY;
  if (Math.abs(diff) < 40) return;
  const t0 = performance.now();
  const dur = 450;
  function stepScroll(now) {
    const u = Math.min(1, (now - t0) / dur);
    const e = 0.5 - Math.cos(Math.PI * u) / 2;
    window.scrollTo(0, startY + diff * e);
    if (u < 1) requestAnimationFrame(stepScroll);
  }
  requestAnimationFrame(stepScroll);
}

function stepToState(targetId, fromId = null, pushHistory = true) {
  const prev = fromId || currentStateId;
  prevStateId = prev;
  currentStateId = targetId;
  const state = STATE_MAP[targetId];

  // Sync guard badges if landing on a bug state
  if (targetId === "s5") guards.causalMask = false;
  if (targetId === "s8") guards.gradClip = false;
  if (targetId === "s12") guards.klLeash = false;
  if (targetId === "s4") guards.causalMask = true;
  if (targetId === "s9") guards.gradClip = true;
  if (targetId === "s13") guards.klLeash = true;
  syncGuardUI();

  if (pushHistory && historyStack[historyStack.length - 1]?.stateId !== targetId) {
    const prevStateObj = STATE_MAP[prev];
    const transitionObj = prevStateObj?.steps.find(st => st.to === targetId);
    historyStack.push({
      stateId: targetId,
      via: transitionObj ? transitionObj.label : `jumped to ${state.num}`
    });
  }

  // Highlight active & visited plates
  const visitedSet = new Set(historyStack.map(h => h.stateId));
  STATES.forEach(s => {
    const el = plateElements[s.id];
    if (!el) return;
    el.classList.toggle("active-state", s.id === targetId);
    el.classList.toggle("visited-state", visitedSet.has(s.id) && s.id !== targetId);
  });

  // Update Stepper UI
  const titleEl = document.getElementById("stepper-title");
  titleEl.textContent = `${state.num} · ${state.title} (${state.subtitle})`;
  titleEl.classList.toggle("bug-title", !!state.breaksRule);
  document.getElementById("stepper-desc").textContent = state.desc;

  // Populate next step choice buttons
  const choicesEl = document.getElementById("stepper-choices");
  choicesEl.innerHTML = "";
  state.steps.forEach(st => {
    const dst = STATE_MAP[st.to];
    const btn = document.createElement("button");
    btn.className = "choice-btn" + (st.bug ? " bug-choice" : "");
    btn.innerHTML = `<span>${st.label}</span> <strong>→ ${dst.num} ${dst.title}</strong>`;
    btn.addEventListener("click", () => {
      stopAutoPlay();
      stepToState(st.to, state.id, true);
      glideScrollToPlate(st.to);
    });
    choicesEl.appendChild(btn);
  });

  // Update history breadcrumbs
  document.getElementById("ctrl-back").disabled = historyStack.length <= 1;
  document.getElementById("path-count").textContent = String(historyStack.length);
  const trailEl = document.getElementById("path-trail");
  trailEl.innerHTML = historyStack.map((item, idx) => {
    const stObj = STATE_MAP[item.stateId];
    return `<span class="path-crumb ${stObj.breaksRule ? 'bug-crumb' : ''}" data-hist-idx="${idx}" title="${item.via}">
      ${idx === 0 ? '' : '→ '}${stObj.num} ${stObj.title}
    </span>`;
  }).join("");
  trailEl.querySelectorAll(".path-crumb").forEach(crumb => {
    crumb.addEventListener("click", () => {
      const idx = parseInt(crumb.getAttribute("data-hist-idx"), 10);
      historyStack = historyStack.slice(0, idx + 1);
      stepToState(historyStack[idx].stateId, currentStateId, false);
    });
  });

  // Expand stepper if minimized
  document.getElementById("stepper").classList.remove("minimized");
  document.getElementById("ctrl-minimize").textContent = "▾ Minimize";
  updateSpotlightAndRoute(prev, targetId, state.breaksRule);
}

function syncGuardUI() {
  const gm = document.getElementById("guard-mask");
  gm.classList.toggle("broken", !guards.causalMask);
  gm.innerHTML = `Causal Mask: <strong>${guards.causalMask ? 'ON (Lower-Tri)' : 'BROKEN (Leaking!)'}</strong>`;

  const gc = document.getElementById("guard-clip");
  gc.classList.toggle("broken", !guards.gradClip);
  gc.innerHTML = `Grad Clip (‖g‖≤1.0): <strong>${guards.gradClip ? 'ON' : 'OFF (Spike Risk!)'}</strong>`;

