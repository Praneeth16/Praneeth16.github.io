---
import {opening,corpus,attentionPlate,transformerPlate,trainingPlate,scalePlate,posttrainingPlate,evaluationPlate,inferencePlate} from '../../../lib/llm-plates.mjs';
import '../../../styles/llm-visual.css';
const frames=[
 {id:'material',title:'Start with text.',caption:'Choose the material. Remove copies. Keep the test apart.',art:corpus(),part:'01 / MATERIAL',file:'corpus'},
 {id:'attention',title:'Let the pieces meet.',caption:'Attention mixes information from the prefix. Future positions stay masked.',art:attentionPlate(),part:'02 / CONTEXT',file:'attentionPlate'},
 {id:'network',title:'Stack the transformations.',caption:'Attention mixes positions. The MLP transforms each position. Repeat the block.',art:transformerPlate(),part:'03 / ARCHITECTURE',file:'transformerPlate'},
 {id:'training',title:'Learn from the miss.',caption:'A target supplies the loss. Gradients tell the optimizer what to change.',art:trainingPlate(),part:'04 / PRETRAINING',file:'trainingPlate'},
 {id:'cluster',title:'Do this together.',caption:'Different batches. Shared gradients. A coordinated update.',art:scalePlate(),part:'05 / SCALE',file:'scalePlate',dark:true},
 {id:'behavior',title:'Practise being helpful.',caption:'Demonstrations teach responses. Preferences or rewards refine behavior.',art:posttrainingPlate(),part:'06 / POST-TRAINING',file:'posttrainingPlate'},
 {id:'checkpoint',title:'Earn the release.',caption:'Test a saved model. Failures send it back for more work.',art:evaluationPlate(),part:'07 / EVALUATION',file:'evaluationPlate'},
 {id:'answer',title:'One token becomes the next.',caption:'The context grows. The cache grows. The weights stay fixed.',art:inferencePlate(),part:'08 / INFERENCE',file:'inferencePlate'}
];
---
<!doctype html>
<html lang="en">
<head>
 <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
 <title>Before the answer · How a language model is made</title>
 <meta name="description" content="A visual journey through how LLMs are built. Follow text into tokens, attention, training, post-training, and the first answer."/>
 <link rel="canonical" href="https://praneeth16.github.io/blog/how-llms-are-built/"/>
 <link rel="icon" href="/favicon.svg"/><meta name="theme-color" content="#f7f5ed"/>
 <meta property="og:title" content="Before the answer"/><meta property="og:description" content="How a language model is made, told in moving drawings."/><meta property="og:type" content="article"/>
 <meta property="og:url" content="https://praneeth16.github.io/blog/how-llms-are-built/"/><meta property="og:image" content="https://praneeth16.github.io/llm/visual-og.png"/><meta name="twitter:card" content="summary_large_image"/>
</head>
<body>
 <a class="skip" href="#material">Skip to the drawings</a>
 <header class="visual-mast"><a href="/">Praneeth Paikray <span>/ visual stories</span></a><div><a href="/blog/how-llms-are-built/notebook/">The working notebook ↗</a><button type="button" id="visual-motion" aria-pressed="false">Pause motion</button></div></header>
 <main>
  <section class="visual-cover" id="beginning" data-scene="0" aria-labelledby="visual-title">
   <div class="cover-type"><p class="kicker">HOW A LANGUAGE MODEL IS MADE</p><h1 id="visual-title">Before the <em>answer.</em></h1><p class="cover-deck">Text goes in. A long apprenticeship follows.</p><a class="start-story" href="#material">Follow the sentence <span>↓</span></a></div>
   <div class="opening-art" set:html={opening()}></div>
   <div class="visual-legend"><span><i class="blue-dot"></i> Information flows</span><span><i class="orange-dot"></i> Feedback & control</span><span>8 scenes · Scroll or step through</span></div>
  </section>
  <div class="frames">
   {frames.map((frame,i)=><section class:list={['visual-frame',frame.dark&&'dark-frame']} id={frame.id} data-scene={i+1} aria-labelledby={'title-'+frame.id}>
    <header class="frame-title"><p class="kicker">{frame.part}</p><h2 id={'title-'+frame.id}>{frame.title}</h2></header>
    <figure><div class="drawing"><div set:html={frame.art}></div><button type="button" class="art-enlarge" data-enlarge={frame.file} data-label={frame.title} aria-label={'Enlarge drawing: '+frame.title}>↗</button></div><figcaption>{frame.caption}</figcaption></figure>
    {frame.id==='attention'&&<div class="scene-control attention-control"><span>Choose a query</span><div class="word-controls" aria-label="Attention query">{['The','small','bird','can','fly'].map((word,j)=><button type="button" data-visual-query={j} aria-pressed={j===4?'true':'false'}>{word}</button>)}</div><output id="visual-attention-status" aria-live="polite">“fly” can attend to all five positions.</output></div>}
    {frame.id==='training'&&<div class="scene-control training-control"><button type="button" id="visual-train">Train one step →</button><button type="button" id="visual-train-reset" class="quiet">Reset ↺</button><output id="visual-train-status" aria-live="polite">Update 0 · Live three-logit toy</output></div>}
    {frame.id==='checkpoint'&&<div class="scene-control gate-control"><button type="button" id="visual-gate" aria-pressed="false">Fail a required check ↺</button><output id="visual-gate-status" aria-live="polite">Illustrative gate: required checks pass.</output></div>}
    {frame.id==='answer'&&<div class="scene-control inference-control"><div class="generated-ribbon" id="visual-context" aria-live="polite">The sky is</div><div class="decode-controls"><button type="button" id="visual-decode">Process the prompt →</button><button type="button" id="visual-decode-reset" class="quiet">Reset ↺</button><label for="visual-temperature">Temperature <output id="visual-temperature-value">0.8</output><input id="visual-temperature" type="range" min="0" max="2" step="0.1" value="0.8"/></label></div><output id="visual-decode-status" aria-live="polite">0 cached positions · 0 weight updates</output></div>}
   </section>)}
  </div>
  <section class="visual-end"><p class="kicker">THE END OF THE APPRENTICESHIP. THE START OF A REQUEST.</p><h2>Now you see<br/><em>what came before.</em></h2><a href="/blog/how-llms-are-built/notebook/">Open the working notebook <span>↗</span></a><p>Equations, experiments, sources, and the checked lifecycle.</p></section>
  <details id="visual-notes" class="visual-notes"><summary>Notes, sources & credits</summary><div><p>A common text-only, dense decoder recipe. Real pipelines vary. The drawings simplify dimensions and sequence boundaries. Interactive values are computed teaching examples, not measurements of a real LLM.</p><p>The attention panel uses invented Q, K, V vectors. The training panel updates three logits directly. The decoding panel uses scripted logits with real softmax sampling. The cluster depicts data parallelism. Pre-normalized blocks also have final normalization and a vocabulary projection.</p><p><a href="/blog/how-llms-are-built/notebook/#sources">Research sources</a> · <a href="/llm/Lifecycle.tla">TLA+ lifecycle</a> · <a href="/llm/lifecycle-report.md">TLC report</a> · <a href="https://github.com/Praneeth16/Praneeth16.github.io/blob/main/src/lib/llm-plates.mjs">Drawing source</a></p><p>Original drawings and visual design by Praneeth Paikray. Inspired by the visual storytelling of Kevin T. Ngo’s <a href="https://kevintngo.github.io/statechart-art/one-becomes-two/">One becomes two</a>. Built with <a href="https://github.com/cursor/plugins/tree/main/pstack">Poteto’s pstack</a> guidance. The 36-state abstract lifecycle was checked with TLC; this does not prove an LLM correct or safe.</p></div></details>
 </main>
 <dialog id="drawing-detail" aria-labelledby="drawing-detail-title"><div class="dialog-head"><h2 id="drawing-detail-title">Inspect the drawing</h2><button type="button" id="drawing-close">Close ×</button></div><p>Scroll across the base illustration to inspect its labels.</p><div class="dialog-drawing"><img id="drawing-large" src="/llm/plates/corpus.svg" alt="Enlarged base illustration" width="1000" height="690"/></div></dialog>
 <nav class="story-player" aria-label="Step through the visual story"><button type="button" id="visual-prev" aria-label="Previous scene" disabled>←</button><div class="player-track"><span id="visual-scene-number">00 / 08</span><span id="visual-scene-name">Before the answer</span><div class="player-line"><i id="visual-progress"></i></div></div><button type="button" id="visual-play" aria-pressed="false">Play</button><button type="button" id="visual-next" aria-label="Next scene">→</button></nav>
 <footer class="visual-footer"><a href="/">← More from Praneeth</a><span>1 November 2026</span><a href="#beginning">Back to the start ↑</a></footer>
 <noscript><p class="no-script">Scroll to read the drawings. JavaScript adds motion controls and numerical experiments.</p></noscript>
 <script is:inline type="module" src="/llm/visual-story.mjs"></script>
</body>
</html>
