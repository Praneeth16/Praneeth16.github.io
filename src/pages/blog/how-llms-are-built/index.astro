/* ============================================================================
   6. PERSPECTIVES — retain each view's place; tab keys follow one convention
   ============================================================================ */
let activeView = "view-chart";
const viewScroll = {};
function switchPerspective(viewId) {
  if (viewId === activeView) return;
  stopAutoPlay();
  viewScroll[activeView] = window.scrollY;
  activeView = viewId;
  document.querySelectorAll(".mode-tab").forEach(tab => {
    const active = tab.dataset.view === viewId;
    tab.classList.toggle("active", active);
    tab.setAttribute("aria-selected", String(active));
    tab.tabIndex = active ? 0 : -1;
  });
  document.querySelectorAll(".view-section").forEach(section => {
    section.classList.toggle("active", section.id === viewId);
  });
  const nav = document.querySelector(".mode-nav-wrap");
  const panelTop = document.getElementById(viewId).offsetTop;
  const targetScroll = viewScroll[viewId] ?? (panelTop - nav.offsetHeight);
  document.getElementById(`tab-${viewId}`).focus({preventScroll: true});
  // Restore after the new panel has laid out; a shorter old view can clamp a synchronous scroll.
  requestAnimationFrame(() => window.scrollTo({top: targetScroll, behavior: "auto"}));
}
const tabs = [...document.querySelectorAll(".mode-tab")];
tabs.forEach((tab, index) => {
  tab.id = `tab-${tab.dataset.view}`;
  tab.setAttribute("aria-controls", tab.dataset.view);
  tab.tabIndex = index === 0 ? 0 : -1;
  const panel = document.getElementById(tab.dataset.view);
  panel.setAttribute("role", "tabpanel");
  panel.setAttribute("aria-labelledby", tab.id);
  tab.addEventListener("click", () => switchPerspective(tab.dataset.view));
  tab.addEventListener("keydown", e => {
    let next;
    if (e.key === "ArrowRight") next = (index + 1) % tabs.length;
    if (e.key === "ArrowLeft") next = (index + tabs.length - 1) % tabs.length;
    if (e.key === "Home") next = 0;
    if (e.key === "End") next = tabs.length - 1;
    if (next !== undefined) { e.preventDefault(); tabs[next].focus(); switchPerspective(tabs[next].dataset.view); }
  });
});
document.querySelectorAll("[data-return-story]").forEach(button => button.addEventListener("click", () => switchPerspective("view-chart")));
document.getElementById("reset-home-link").addEventListener("click", e => { e.preventDefault(); switchPerspective("view-chart"); window.scrollTo({top: 0, behavior: reducedMotion.matches ? "auto" : "smooth"}); });

