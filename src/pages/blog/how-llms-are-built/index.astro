function projectIso(x, y, z, cx, cy, scale, yaw, pitch) {
  const cosY = Math.cos(yaw), sinY = Math.sin(yaw);
  const rx = x * cosY - z * sinY;
  const rz = x * sinY + z * cosY;
  const sx = cx + rx * scale;
  const sy = cy + (y + rz * Math.sin(pitch)) * scale;
  return { x: sx, y: sy };
}

function drawIsoWireBox(ctx, bx, by, bz, bw, bh, bd, cx, cy, scale, yaw, pitch, strokeCol, fillCol, seed, wobble) {
  const pts = [
    [-bw, -bh, -bd], [bw, -bh, -bd], [bw, bh, -bd], [-bw, bh, -bd],
    [-bw, -bh,  bd], [bw, -bh,  bd], [bw, bh,  bd], [-bw, bh,  bd]
  ].map(([vx, vy, vz]) => projectIso(bx + vx, by + vy, bz + vz, cx, cy, scale, yaw, pitch));

  if (fillCol) {
    ctx.save();
    ctx.fillStyle = fillCol;
    ctx.beginPath();
    [0, 1, 5, 4].forEach((idx, i) => i === 0 ? ctx.moveTo(pts[idx].x, pts[idx].y) : ctx.lineTo(pts[idx].x, pts[idx].y));
    ctx.closePath();
    ctx.fill();
    ctx.beginPath();
    [1, 2, 6, 5].forEach((idx, i) => i === 0 ? ctx.moveTo(pts[idx].x, pts[idx].y) : ctx.lineTo(pts[idx].x, pts[idx].y));
    ctx.closePath();
    ctx.fill();
    ctx.restore();
  }

  const edges = [
    [0,1],[1,2],[2,3],[3,0],
    [4,5],[5,6],[6,7],[7,4],
    [0,4],[1,5],[2,6],[3,7]
  ];
  edges.forEach(([a, b], idx) => {
    handLine(ctx, pts[a].x, pts[a].y, pts[b].x, pts[b].y, strokeCol, 1.8, seed + idx, wobble);
  });
  return pts[0];
}

function renderIsoMachine(nowSec, frameIdx) {
  const canvas = document.getElementById("iso-canvas");
  if (!canvas) return;
  const ctx = canvas.getContext("2d");
  const w = canvas.width, h = canvas.height;

  if (isoState.turntable && !isoState.dragging) {
    isoState.yaw += 0.008;
    const deg = Math.round(((isoState.yaw * 180 / Math.PI) % 360 + 360) % 360);
    document.getElementById("iso-angle-readout").textContent = `${deg}°`;
  }

  drawPaperTooth(ctx, w, h, "#efe5ce", frameIdx);
  const cx = w * 0.5;
  const cy = h * 0.52;
  const scale = 1.18;
  const pal = SWATCH_COLORS[isoState.swatch] || SWATCH_COLORS.terracotta;
  const wob = isoState.wobble * 1.3;
  const seed = 700 + frameIdx * 29;

  // Isometric floor grid
  for (let g = -220; g <= 220; g += 55) {
    const p1 = projectIso(g, 135, -220, cx, cy, scale, isoState.yaw, isoState.pitch);
    const p2 = projectIso(g, 135,  220, cx, cy, scale, isoState.yaw, isoState.pitch);
    handLine(ctx, p1.x, p1.y, p2.x, p2.y, "rgba(34,31,27,0.14)", 1, seed + g, wob * 0.4);
    const q1 = projectIso(-220, 135, g, cx, cy, scale, isoState.yaw, isoState.pitch);
    const q2 = projectIso( 220, 135, g, cx, cy, scale, isoState.yaw, isoState.pitch);
    handLine(ctx, q1.x, q1.y, q2.x, q2.y, "rgba(34,31,27,0.14)", 1, seed + g + 500, wob * 0.4);
  }

  // Outer Transformer & GPU Pod Chassis
  const shellFill = isoState.seeThrough ? "rgba(200, 90, 66, 0.14)" : pal.shell;
  drawIsoWireBox(ctx, 0, 0, 0, 185, 125, 135, cx, cy, scale, isoState.yaw, isoState.pitch, "#221f1b", shellFill, seed + 10, wob);

  // Internal Working Parts (visible in See-Through or X-Ray outline)
  const partAnchors = {};

  // Part 1: BPE Tokenizer Hopper & Embedding Table (Bottom Left)
  partAnchors[1] = drawIsoWireBox(
    ctx, -115, 65, 0, 46, 38, 82, cx, cy, scale, isoState.yaw, isoState.pitch,
    isoState.selectedPart === 1 ? "#d9383a" : "#221f1b",
    isoState.seeThrough ? "rgba(240, 200, 106, 0.65)" : null,
    seed + 100, wob
  );

  // Part 2: RoPE Rotary Phase Gears
  const gearCenter = projectIso(-45, 45, 0, cx, cy, scale, isoState.yaw, isoState.pitch);
  handCircle(ctx, gearCenter.x, gearCenter.y, 32, "#221f1b", "rgba(126, 224, 198, 0.72)", 2.0, seed + 200, wob);
  const gAngle = nowSec * 2.4;
  handLine(ctx, gearCenter.x, gearCenter.y, gearCenter.x + Math.cos(gAngle) * 28, gearCenter.y + Math.sin(gAngle) * 28, "#d9383a", 2.4, seed + 210, wob);
  partAnchors[2] = gearCenter;

  // Part 3: Multi-Head Causal Attention Drum (Center)
  partAnchors[3] = drawIsoWireBox(
    ctx, 10, -10, 0, 56, 48, 76, cx, cy, scale, isoState.yaw, isoState.pitch,
    isoState.selectedPart === 3 ? "#d9383a" : "#221f1b",
    isoState.seeThrough ? "rgba(46, 94, 170, 0.55)" : null,
    seed + 300, wob
  );

  // Part 4: SwiGLU / Top-2 MoE Sparse Expert Banks (Upper Right)
  for (let ex = -1; ex <= 1; ex++) {
    const anchor = drawIsoWireBox(
      ctx, 108, -32 + ex * 38, 0, 42, 14, 65, cx, cy, scale, isoState.yaw, isoState.pitch,
      "#221f1b",
      ex === 0 ? "rgba(240, 200, 106, 0.85)" : "rgba(60, 141, 109, 0.58)",
      seed + 400 + ex * 20, wob
    );
    if (ex === -1) partAnchors[4] = anchor;
  }

  // Part 5: NVLink All-Reduce Ring & Grad Clipper (Top Crown)
  const ringCenter = projectIso(0, -105, 0, cx, cy, scale, isoState.yaw, isoState.pitch);
  handCircle(ctx, ringCenter.x, ringCenter.y, 44, isoState.spikeAlert ? "#e72e3b" : "#221f1b", isoState.spikeAlert ? "rgba(231,46,59,0.55)" : "rgba(240,200,106,0.45)", 2.2, seed + 500, wob);
  partAnchors[5] = ringCenter;

  // Part 6: PagedAttention KV-Cache Memory Drawer (Bottom Right)
  partAnchors[6] = drawIsoWireBox(
    ctx, 105, 76, 0, 48, 30, 78, cx, cy, scale, isoState.yaw, isoState.pitch,
    isoState.selectedPart === 6 ? "#d9383a" : "#221f1b",
    isoState.seeThrough ? "rgba(122, 73, 114, 0.62)" : null,
    seed + 600, wob
  );

  // Animated Token Particles Flowing Through the Machine
  for (let p = 0; p < 6; p++) {
    const u = ((nowSec * 0.55) + p / 6) % 1;
    const tx = -140 + u * 280;
    const ty = Math.sin(u * Math.PI * 2) * 35;
    const pt = projectIso(tx, ty, 0, cx, cy, scale, isoState.yaw, isoState.pitch);
    handCircle(ctx, pt.x, pt.y, 7, "#221f1b", isoState.spikeAlert ? "#ff4d4d" : "#f0c86a", 1.6, seed + 700 + p, wob * 0.6);
  }

  // Draw Numbered Callout Badges if Labels are ON
  if (isoState.labelsOn) {
    ctx.save();
    ctx.font = "bold 12px 'IBM Plex Mono', monospace";
    for (let k = 1; k <= 6; k++) {
      const pt = partAnchors[k];
      if (!pt) continue;
      const isSel = isoState.selectedPart === k;
      handCircle(ctx, pt.x, pt.y - 12, isSel ? 14 : 11, "#221f1b", isSel ? "#f0c86a" : "#fffdf7", 2.0, seed + 800 + k, wob * 0.5);
      ctx.fillStyle = "#221f1b";
      ctx.fillText(String(k), pt.x - 4, pt.y - 8);
    }
    ctx.restore();
  }
}

/* ============================================================================
   8. VIEW 3: FIELDNOTES PLACE (SPATIAL CROSS-SECTION OF THE 4 WORLDS)
   ============================================================================ */
let activePlaceZone = 0;
let placeBubbleText = "Tap any room or engineer! Currently inspecting: MinHash deduplication sieve.";

const placeCanvas = document.getElementById("place-canvas");
if (placeCanvas) {
  placeCanvas.addEventListener("click", (e) => {
    const rect = placeCanvas.getBoundingClientRect();
    const xRatio = (e.clientX - rect.left) / rect.width;
    const zone = Math.min(3, Math.max(0, Math.floor(xRatio * 4)));
    selectPlaceZone(zone);
  });
}

function selectPlaceZone(zone) {
  activePlaceZone = zone;
  const titles = [
    "I. The Web & Corpus Foundry (15T Tokens)",
    "II. The 25-Megawatt 16,384-GPU Datacenter Pod",
    "III. The Alignment & GRPO Verification Studio",
    "IV. The Low-Latency PagedAttention Serving Engine"
  ];
  const bubbles = [
    "Engineer Maya: 'We filtered 300B CommonCrawl pages down to 15T clean tokens and merged 128,256 BPE subwords!'",
    "Cluster Ops Dev: 'All 16,384 H100s synced over 900 GB/s NVLink! Grad norm clipped at 0.94 — zero NaN spikes!'",
    "Alignment Lead Priya: 'GRPO sampled 8 reasoning chains; math verifier rewarded proof #3 while KL β=0.04 kept calibration tight!'",
    "Inference Daemon: 'PagedAttention cached 32K prompt tokens in 16-token blocks — streaming response at 18 ms/token!'"
  ];
  document.getElementById("place-zone-label").textContent = titles[zone];
  placeBubbleText = bubbles[zone];
  document.querySelectorAll("#place-cards .place-card").forEach(c => {
    c.classList.toggle("active", parseInt(c.getAttribute("data-zone"), 10) === zone);
  });
}

document.querySelectorAll("#place-cards .place-card").forEach(card => {
  card.addEventListener("click", () => {
    selectPlaceZone(parseInt(card.getAttribute("data-zone"), 10));
  });
});

function renderPlaceCrossSection(nowSec, frameIdx) {
  if (!placeCanvas) return;
  const ctx = placeCanvas.getContext("2d");
  const w = placeCanvas.width, h = placeCanvas.height;
  drawPaperTooth(ctx, w, h, "#e9dbb9", frameIdx);
  const seed = 1200 + frameIdx * 41;
  const zw = (w - 40) / 4;

  const zoneMeta = [
    { title: "I. CORPUS FOUNDRY", bg: "#dfd0ad", accent: "#c85a42" },
    { title: "II. 16K GPU CLUSTER", bg: "#cfd8dc", accent: "#2e5eaa" },
    { title: "III. ALIGNMENT STUDIO", bg: "#d4e4d8", accent: "#3c8d6d" },
    { title: "IV. SERVING ENGINE", bg: "#e2d6e6", accent: "#7a4972" }
  ];

  for (let z = 0; z < 4; z++) {
    const x = 20 + z * zw;
    const y = 52;
    const zh = h - 118;
    const isAct = z === activePlaceZone;
    handRect(ctx, x + 6, y, zw - 12, zh, isAct ? "#221f1b" : "rgba(34,31,27,0.4)", zoneMeta[z].bg, isAct ? 2.8 : 1.4, seed + z * 20, 1.3);

    ctx.save();
    ctx.font = "bold 13px 'IBM Plex Mono', monospace";
    ctx.fillStyle = "#221f1b";
    ctx.fillText(zoneMeta[z].title, x + 18, y + 26);

    // Room-specific hand-drawn equipment & animated workers
    const cx = x + zw / 2;
    const cy = y + zh / 2;

    if (z === 0) {
      // Hopper & BPE conveyor belt
      handRect(ctx, cx - 55, cy - 60, 110, 48, "#221f1b", "#f0c86a", 1.8, seed + 101);
      ctx.fillText("MinHash + BPE", cx - 46, cy - 32);
      for (let b = 0; b < 4; b++) {
        const bx = x + 28 + ((nowSec * 45 + b * 52) % (zw - 66));
        handRect(ctx, bx, cy + 18, 28, 20, "#221f1b", "#fffdf7", 1.4, seed + 110 + b);
      }
    } else if (z === 1) {
      // 3 Server Racks with blinking NVLink LEDs
      for (let r = -1; r <= 1; r++) {
        const rx = cx + r * 62 - 22;
        handRect(ctx, rx, cy - 70, 44, 130, "#221f1b", "#263238", 1.8, seed + 200 + r);
        for (let u = 0; u < 5; u++) {
          const ledCol = ((Math.floor(nowSec * 5) + u + r) % 3 === 0) ? "#f0c86a" : "#6ee7b7";
          handCircle(ctx, rx + 22, cy - 50 + u * 22, 5, "#221f1b", ledCol, 1.2, seed + 220 + u);
        }
      }
    } else if (z === 2) {
      // Human annotator desk + GRPO verifier chalkboard
      handRect(ctx, cx - 75, cy - 68, 150, 64, "#221f1b", "#2d4236", 1.8, seed + 300);
      ctx.fillStyle = "#f0c86a";
      ctx.fillText("π_θ / π_ref · KL=0.04", cx - 64, cy - 32);
      // Stick-figure researcher waving
      handCircle(ctx, cx, cy + 28, 14, "#221f1b", "#f4d393", 1.8, seed + 310);
      handLine(ctx, cx, cy + 42, cx, cy + 82, "#221f1b", 2.2, seed + 311);
      handLine(ctx, cx, cy + 54, cx + 24, cy + 36 + Math.sin(nowSec * 5) * 8, "#221f1b", 2.0, seed + 312);
    } else if (z === 3) {
      // PagedAttention KV blocks & streaming token pipe
      for (let p = 0; p < 6; p++) {
        const px = cx - 70 + (p % 3) * 48;
        const py = cy - 55 + Math.floor(p / 3) * 38;
        handRect(ctx, px, py, 38, 26, "#221f1b", "#f0c86a", 1.5, seed + 400 + p);
      }
      ctx.fillStyle = "#221f1b";
      ctx.fillText("KV Page Table → 60 tok/s", cx - 78, cy + 56);
    }
    ctx.restore();
  }

  // Speech bubble banner at bottom of Place canvas
  handRect(ctx, 26, h - 52, w - 52, 38, "#221f1b", "#fffdf7", 2.0, seed + 900, 1.0);
  ctx.save();
  ctx.font = "14px 'IBM Plex Mono', monospace";
  ctx.fillStyle = "#221f1b";
  ctx.fillText(placeBubbleText, 42, h - 28);
  ctx.restore();
}

/* ============================================================================
   9. VIEW 4: FIELDNOTES TIME TAPE & CHINCHILLA SCALING CALCULATOR
   ============================================================================ */
const TIME_STOPS = [
  { pos: 8,  label: "12 ns",     detail: "1 H100 Tensor Core FP16 Matrix-Multiply-Accumulate (MMA)" },
  { pos: 24, label: "18 ms",     detail: "1 Autoregressive Token Decoded via PagedAttention KV-Cache" },
  { pos: 40, label: "110 ms",    detail: "1 Forward Pass through 80 Transformer Layers (4,096 context)" },
  { pos: 54, label: "420 ms",    detail: "1 Global 3D-Parallel Step (Forward + Backward + NVLink All-Reduce)" },
  { pos: 72, label: "14 hours",  detail: "Supervised Fine-Tuning (SFT) on 100,000 Reasoning Demonstrations" },
  { pos: 84, label: "12 days",   detail: "RLHF & GRPO Verifier Rollouts with KL Penalty Leash" },
  { pos: 96, label: "90 days",   detail: "Full Pre-Training Run (15 Trillion Tokens across 16,384 GPUs)" }
];

let timeSliderVal = 52;
document.getElementById("time-log-slider").addEventListener("input", (e) => {
  timeSliderVal = parseInt(e.target.value, 10);
  let nearest = TIME_STOPS[0];
  TIME_STOPS.forEach(st => {
    if (Math.abs(st.pos - timeSliderVal) < Math.abs(nearest.pos - timeSliderVal)) nearest = st;
  });
  document.getElementById("time-cursor-readout").textContent = `${nearest.label} (${nearest.detail})`;
});

function renderTimeTape(_nowSec, frameIdx) {
  const canvas = document.getElementById("time-canvas");
  if (!canvas) return;
  const ctx = canvas.getContext("2d");
  const w = canvas.width, h = canvas.height;
  drawPaperTooth(ctx, w, h, "#ede1c5", frameIdx);
  const seed = 1600 + frameIdx * 23;

  // Horizontal logarithmic tape axis
  const yAxis = h * 0.52;
  handLine(ctx, 40, yAxis, w - 40, yAxis, "#221f1b", 3.0, seed + 1, 1.4);

  TIME_STOPS.forEach((st, idx) => {
    const x = 40 + (st.pos / 100) * (w - 80);
    const active = Math.abs(st.pos - timeSliderVal) < 10;
    const yCard = idx % 2 === 0 ? yAxis - 78 : yAxis + 28;
    handLine(ctx, x, yAxis - 10, x, idx % 2 === 0 ? yAxis - 34 : yAxis + 28, "#221f1b", 1.8, seed + idx + 10);
    handCircle(ctx, x, yAxis, active ? 10 : 6.5, "#221f1b", active ? "#d9383a" : "#f0c86a", 1.8, seed + idx + 20);
    handRect(ctx, x - 62, yCard, 124, 44, "#221f1b", active ? "#f0c86a" : "#fffdf7", active ? 2.2 : 1.3, seed + idx + 30);

    ctx.save();
    ctx.font = "bold 12px 'IBM Plex Mono', monospace";
    ctx.fillStyle = "#221f1b";
    ctx.fillText(st.label, x - 52, yCard + 18);
    ctx.font = "10.5px 'IBM Plex Mono', monospace";
    ctx.fillText(st.detail.slice(0, 18) + "…", x - 52, yCard + 34);
    ctx.restore();
  });

  // Scrubber cursor line
  const cx = 40 + (timeSliderVal / 100) * (w - 80);
  handLine(ctx, cx, 16, cx, h - 16, "#d9383a", 2.4, seed + 99, 0.9);
}

function updateScalingCalculator() {
  const N_bil = parseFloat(document.getElementById("calc-n-slider").value);
  const D_tril = parseFloat(document.getElementById("calc-d-slider").value);
  document.getElementById("calc-n-label").textContent = `${N_bil} Billion`;
  document.getElementById("calc-d-label").textContent = `${D_tril.toFixed(1)} Trillion`;

  // C = 6 * N * D
  const flopsExp24 = (6 * (N_bil * 1e9) * (D_tril * 1e12)) / 1e24;
  document.getElementById("calc-flops-out").textContent = `${flopsExp24.toFixed(2)} × 10²⁴ FLOPs`;

  // Days on 8,192 H100s at 45% MFU (~445 TFLOP/s effective per GPU)
  const clusterFlopsPerSec = 8192 * 445e12;
  const days = (flopsExp24 * 1e24) / (clusterFlopsPerSec * 86400);
  document.getElementById("calc-days-out").textContent = `~${Math.max(1, Math.round(days))} idealized compute days at assumed 8,192 × 445 TFLOP/s`;

  // Memory = 16 bytes * N
  const vramGB = Math.round(N_bil * 16);
  document.getElementById("calc-mem-out").textContent = `${vramGB.toLocaleString()} GB VRAM`;

  // Parametric Chinchilla loss L(N,D) = E + A / N^0.34 + B / D^0.28
  const E = 1.69;
  const A = 406.4 / Math.pow(N_bil * 1e9, 0.34);
  const B = 410.7 / Math.pow(D_tril * 1e12, 0.28);
  const loss = E + A + B;
  document.getElementById("calc-loss-out").textContent = `${loss.toFixed(3)} nats / token`;

  const ratio = Math.round((D_tril * 1000) / N_bil);
  const optNote = ratio > 40 ? "Above historical ~20× reference" : (ratio >= 18 ? "Near historical ~20× reference" : "Below historical ~20× reference");
  document.getElementById("calc-ratio-out").textContent = `Token/Param Ratio: ${ratio}× (${optNote})`;
}

document.getElementById("calc-n-slider").addEventListener("input", updateScalingCalculator);
document.getElementById("calc-d-slider").addEventListener("input", updateScalingCalculator);

/* ============================================================================
   10. MASTER ANIMATION LOOP (180ms [0,1,2,1] WOBBLE + COSINE ROUTE + SCOPE)
   ============================================================================ */
const WOBBLE_SEQ = [0, 1, 2, 1];
const scopeCanvas = document.getElementById("scope-canvas");
const scopeCtx = scopeCanvas.getContext("2d");

function masterTick(now) {
  const nowSec = now / 1000;
  const seqIdx = Math.floor(now / 180) % 4;
  const frameIdx = WOBBLE_SEQ[seqIdx];

  document.getElementById("scope-frame-indicator").textContent =
    `pencil+pastel · wobble frame ${seqIdx + 1}/4`;

  // 1. Render Circular Scope Canvas for Active State
  const activeState = STATE_MAP[currentStateId];
  if (activeState) {
    renderStateArtwork(scopeCtx, scopeCanvas.width, scopeCanvas.height, activeState, frameIdx, nowSec);
  }

  // 2. Render Active View Canvases
  const chartActive = document.getElementById("view-chart").classList.contains("active");
  if (chartActive) {
    STATES.forEach(st => {
      const c = plateCanvases[st.id];
      if (c) renderStateArtwork(c.getContext("2d"), c.width, c.height, st, frameIdx, nowSec);
    });

    // Update cosine-eased SVG route animation (#step-route & #step-token)
    if (routeAnim.active) {
      const route = document.getElementById("step-route");
      const token = document.getElementById("step-token");
      const L = route.getTotalLength();
      if (L > 0) {
        const u = Math.min(1, (now - routeAnim.t0) / routeAnim.dur);
        const e = 0.5 - Math.cos(Math.PI * u) / 2;
        route.style.strokeDashoffset = `${L * (1 - e)}`;
        const pt = route.getPointAtLength(e * L);
        token.setAttribute("cx", pt.x.toFixed(1));
        token.setAttribute("cy", pt.y.toFixed(1));
        token.setAttribute("opacity", "1");
        if (u >= 1) routeAnim.active = false;
      }
    }
  } else if (document.getElementById("view-machine").classList.contains("active")) {
    renderIsoMachine(nowSec, frameIdx);
  } else if (document.getElementById("view-place").classList.contains("active")) {
    renderPlaceCrossSection(nowSec, frameIdx);
  } else if (document.getElementById("view-time").classList.contains("active")) {
    renderTimeTape(nowSec, frameIdx);
  }

  requestAnimationFrame(masterTick);
}

window.addEventListener("resize", () => {
  drawStaticWallEdges();
  updateSpotlightAndRoute(prevStateId, currentStateId, STATE_MAP[currentStateId].breaksRule);
});

// Initialize everything on load
window.addEventListener("DOMContentLoaded", () => {
  buildWallDOM();
  updateScalingCalculator();
  setTimeout(() => {
    drawStaticWallEdges();
    stepToState("s0", "s0", false);
    if (matchMedia("(max-width: 720px)").matches) {
      document.getElementById("stepper").classList.add("minimized");
      document.getElementById("ctrl-minimize").textContent = "▴ Expand";
    }
  }, 60);
  requestAnimationFrame(masterTick);
  document.fonts?.ready.then(() => { drawStaticWallEdges(); updateSpotlightAndRoute(prevStateId, currentStateId, STATE_MAP[currentStateId].breaksRule); });
});
</script>
