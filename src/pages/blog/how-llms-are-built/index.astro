// Stepper control buttons & guided tours
function stopAutoPlay() {
  if (autoPlayTimer) {
    clearInterval(autoPlayTimer);
    autoPlayTimer = null;
  }
  const playBtn = document.getElementById("ctrl-play");
  playBtn.classList.remove("playing");
  playBtn.textContent = "▶ Play";
}

function runGuidedTour(pathIds) {
  stopAutoPlay();
  switchPerspective("view-chart");
  historyStack = [{ stateId: pathIds[0], via: "tour start" }];
  stepToState(pathIds[0], pathIds[0], false);
  glideScrollToPlate(pathIds[0]);

  let i = 1;
  const playBtn = document.getElementById("ctrl-play");
  playBtn.classList.add("playing");
  playBtn.textContent = "⏸ Playing...";

  autoPlayTimer = setInterval(() => {
    if (i >= pathIds.length) {
      stopAutoPlay();
      return;
    }
    const nextId = pathIds[i];
    stepToState(nextId, currentStateId, true);
    glideScrollToPlate(nextId);
    i++;
  }, 1500);
}

document.getElementById("ctrl-back").addEventListener("click", () => {
  stopAutoPlay();
  if (historyStack.length > 1) {
    const popped = historyStack.pop();
    const target = historyStack[historyStack.length - 1];
    stepToState(target.stateId, popped.stateId, false);
    glideScrollToPlate(target.stateId);
  }
});

document.getElementById("ctrl-reset").addEventListener("click", () => {
  stopAutoPlay();
  guards.causalMask = true;
  guards.gradClip = true;
  guards.klLeash = true;
  historyStack = [{ stateId: "s0", via: "reset" }];
  stepToState("s0", currentStateId, false);
  glideScrollToPlate("s0");
});

document.getElementById("ctrl-play").addEventListener("click", () => {
  if (autoPlayTimer) {
    stopAutoPlay();
  } else {
    // Healthy path tour from current state or full lifecycle
    const healthyOrder = ["s0", "s1", "s2", "s3", "s4", "s6", "s7", "s9", "s10", "s11", "s13", "s14", "s15"];
    const startIdx = Math.max(0, healthyOrder.indexOf(currentStateId));
    const slice = healthyOrder.slice(startIdx);
    runGuidedTour(slice.length > 1 ? slice : healthyOrder);
  }
});

