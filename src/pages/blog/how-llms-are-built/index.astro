const wallGrid = document.getElementById("wall-grid");
const plateElements = {};
const plateCanvases = {};

function buildWallDOM() {
  wallGrid.innerHTML = "";
  PHASES.forEach(phase => {
    const chapter = document.createElement("section");
    chapter.className = "chapter";
    chapter.id = phase.id;
    chapter.setAttribute("aria-labelledby", `${phase.id}-title`);
    chapter.innerHTML = `<header class="phase-banner"><h2 class="phase-title" id="${phase.id}-title" style="margin:0;font-weight:400">${phase.title}</h2><span class="phase-meta">${phase.meta}</span></header>`;
    const grid = document.createElement("div");
    grid.className = "chapter-cards";
    chapter.appendChild(grid);
    const failures = STATES.filter(s => s.phase === phase.id && s.breaksRule);
    let failureGrid;
    if (failures.length) {
      const notes = document.createElement("details");
      notes.className = "failure-notes";
      notes.innerHTML = `<summary>What can go wrong? · ${failures[0].title}</summary><div class="chapter-cards"></div>`;
      failureGrid = notes.querySelector(".chapter-cards");
      chapter.appendChild(notes);
    }
    STATES.filter(s => s.phase === phase.id).forEach(state => {
      const card = document.createElement("button");
      card.type = "button";
      card.className = "plate" + (state.breaksRule ? " breaks-rule" : "");
      card.id = `plate-${state.id}`;
      card.style.backgroundColor = state.paperBg;
      card.style.color = state.paperText;
      card.setAttribute("aria-label", `Open ${state.title}`);
      card.setAttribute("aria-haspopup", "dialog");
      const idx = HEALTHY_ORDER.indexOf(state.id);
      card.innerHTML = `
        <div class="plate-pin"></div>
        <div>
          <div class="plate-header">
            <span class="plate-id">${state.breaksRule ? 'DETOUR' : 'SCENE ' + String(idx + 1).padStart(2, '0')}</span>
            <span class="plate-tag">${state.breaksRule ? '⚡ Failure path' : state.paperTag}</span>
          </div>
          <div class="plate-canvas-wrap"><canvas class="plate-canvas" width="480" height="330" aria-hidden="true"></canvas></div>
          <h3 class="plate-title">${state.title}</h3>
          <p class="plate-caption">${state.subtitle}</p>
        </div>
        <div class="plate-open">Open scene ＋</div>`;
      card.addEventListener("click", () => openReader(state.id, card));
      (state.breaksRule ? failureGrid : grid).appendChild(card);
      plateElements[state.id] = card;
      plateCanvases[state.id] = card.querySelector("canvas");
      plateObserver.observe(card);
      sceneResolutionObserver.observe(plateCanvases[state.id]);
    });
    wallGrid.appendChild(chapter);
  });

  // Also populate "Read the Chart as Text" list in View 5
  const textList = document.getElementById("state-text-list");
  if (textList) {
    textList.innerHTML = STATES.map(s => {
      const lines = s.steps.map(st => {
        const dst = STATE_MAP[st.to];
        return `<div class="transition-line ${st.bug ? 'bug' : ''}">• ${st.label} → <strong>${dst.num} ${dst.title}</strong></div>`;
      }).join("");
      return `<div class="state-text-item">
        <strong>${s.num}. ${s.title}</strong> <span style="font-family:var(--font-mono);font-size:11px;opacity:0.75;">(${s.paperTag}${s.breaksRule ? ' · BREAKS ' + s.ruleName : ''})</span>
        ${lines}
      </div>`;
    }).join("");
  }
}

/* ============================================================================
   5. FOCUSED SCENE READER — one route, optional branches, persistent navigation
   ============================================================================ */
const HEALTHY_ORDER = ["s0", "s1", "s2", "s3", "s4", "s6", "s7", "s9", "s10", "s11", "s13", "s14", "s15"];
const CHAPTER_NAMES = ["Data", "Transformer", "Training", "Assistant"];
const reader = document.getElementById("stepper");
const readerBody = document.getElementById("reader-body");
const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
const visiblePlates = new Set();
const plateObserver = new IntersectionObserver(entries => {
  entries.forEach(entry => entry.isIntersecting ? visiblePlates.add(entry.target.id.slice(6)) : visiblePlates.delete(entry.target.id.slice(6)));
}, {rootMargin: "100px"});
// Match the drawing buffer to the displayed size, with a cap for phone memory.
const sceneResolutionObserver = new ResizeObserver(entries => {
  entries.forEach(({target, contentRect}) => {
    if (contentRect.width < 1 || contentRect.height < 1) return;
    const ratio = Math.min(window.devicePixelRatio || 1, 2);
    const width = Math.min(1200, Math.round(contentRect.width * ratio));
    const height = Math.round(width * contentRect.height / contentRect.width);
    if (target.width !== width || target.height !== height) { target.width = width; target.height = height; }
  });
});
let sceneStartedAt = performance.now();
let currentStateId = "s0";
let historyStack = [];
let activeTour = null;
let autoPlayTimer = null;
let returnFocus = null;
let returnScroll = 0;
let savedBodyTop = "";
let pendingReturn = false;

function primaryNext(id) {
  if (id === "s15") return null;
  const index = HEALTHY_ORDER.indexOf(id);
  return index >= 0 ? HEALTHY_ORDER[index + 1] : STATE_MAP[id].steps.find(step => !step.bug)?.to;
}
function nextSceneId() {
  if (activeTour) return activeTour[activeTour.indexOf(currentStateId) + 1] || null;
  return primaryNext(currentStateId);
}
function previousSceneId() {
  if (historyStack.length > 1) return historyStack[historyStack.length - 2].stateId;
  if (activeTour) return activeTour[activeTour.indexOf(currentStateId) - 1] || null;
  const index = HEALTHY_ORDER.indexOf(currentStateId);
  if (index >= 0) return HEALTHY_ORDER[index - 1] || null;
  return {s5: "s4", s8: "s7", s12: "s11"}[currentStateId] || null;
}
function setReaderLocation() {
  if (reader.open) history.replaceState({...history.state, llmReader: true}, "", `#scene-${currentStateId}`);
}
function openReader(id, trigger = document.activeElement, tour = null, updateHistory = true) {
  stopAutoPlay();
  activeTour = tour;
  guards.causalMask = guards.gradClip = guards.klLeash = true;
  historyStack = [{stateId: id, via: "Opened scene"}];
  if (!reader.open) {
    returnFocus = trigger;
    returnScroll = window.scrollY;
    if (updateHistory) history.pushState({llmReader: true, returnScroll}, "", `#scene-${id}`);
    savedBodyTop = document.body.style.top;
    document.body.style.top = `-${returnScroll}px`;
    document.body.classList.add("reader-open");
    reader.showModal();

  }
  stepToState(id, null, false);
}
function cleanupReader() {
  stopAutoPlay();
  document.body.classList.remove("reader-open");
  document.body.style.top = savedBodyTop;
  window.scrollTo(0, returnScroll);
  returnFocus?.focus({preventScroll: true});
}
function closeReader() {
  if (!reader.open) return;
  reader.close();
  cleanupReader();
  if (history.state?.llmReader) { pendingReturn = true; history.back(); }
}
reader.addEventListener("cancel", e => { e.preventDefault(); closeReader(); });
reader.addEventListener("click", e => { if (e.target === reader) { const rect = reader.getBoundingClientRect(); if (e.clientX < rect.left || e.clientX > rect.right || e.clientY < rect.top || e.clientY > rect.bottom) closeReader(); } });
window.addEventListener("popstate", event => {
  const id = location.hash.replace("#scene-", "");
  if (event.state?.llmReader && STATE_MAP[id]) {
    if (!reader.open) {
      window.scrollTo(0, event.state.returnScroll || 0);
      openReader(id, returnFocus, null, false);
    } else stepToState(id);
  } else if (reader.open || pendingReturn) {
    if (reader.open) { reader.close(); cleanupReader(); }
    pendingReturn = false;
    requestAnimationFrame(() => window.scrollTo(0, returnScroll));
  }
});
document.getElementById("ctrl-close").addEventListener("click", closeReader);

function stepToState(targetId, fromId = currentStateId, pushHistory = true) {
  const state = STATE_MAP[targetId];
  if (!state) return;
  currentStateId = targetId;
  sceneStartedAt = performance.now();
  if (targetId === "s5") guards.causalMask = false;
  if (targetId === "s8") guards.gradClip = false;
  if (targetId === "s12") guards.klLeash = false;
  if (targetId === "s4") guards.causalMask = true;
  if (targetId === "s9") guards.gradClip = true;
  if (targetId === "s13" || (fromId === "s12" && targetId === "s11")) guards.klLeash = true;
  if (fromId === "s8" && targetId === "s7") guards.gradClip = true;
  syncGuardUI();
  if (pushHistory && historyStack.at(-1)?.stateId !== targetId) {
    const transition = STATE_MAP[fromId]?.steps.find(st => st.to === targetId);
    historyStack.push({stateId: targetId, via: transition?.label || "Explore scene"});
  }
  const visitedSet = new Set(historyStack.map(h => h.stateId));
  STATES.forEach(s => {
    plateElements[s.id]?.classList.toggle("active-state", s.id === targetId);
    plateElements[s.id]?.classList.toggle("visited-state", visitedSet.has(s.id) && s.id !== targetId);
  });
  const title = document.getElementById("stepper-title");
  title.textContent = state.title;
  title.classList.toggle("bug-title", state.breaksRule);
  const chapterIndex = PHASES.findIndex(p => p.id === state.phase);
  document.getElementById("reader-chapter").textContent = `Chapter ${chapterIndex + 1} · ${CHAPTER_NAMES[chapterIndex]}`;
  document.getElementById("reader-subtitle").textContent = state.subtitle;
  document.getElementById("stepper-desc").textContent = state.desc;
  document.getElementById("scope-canvas").setAttribute("aria-label", `Animated illustration: ${state.title}`);
  const detourAnchor = {s5: "s4", s8: "s7", s12: "s11"}[targetId];
  const position = activeTour ? activeTour.indexOf(targetId) + 1 : HEALTHY_ORDER.indexOf(detourAnchor || targetId) + 1;
  const total = activeTour?.length || HEALTHY_ORDER.length;
  const isFailureTour = activeTour?.some(id => STATE_MAP[id].breaksRule);
  const progressLabel = `${state.breaksRule && !activeTour ? 'Detour · scene' : isFailureTour ? 'Failure path' : 'Scene'} ${position} of ${total}`;
  document.getElementById("reader-position").textContent = progressLabel;
  document.getElementById("reader-announcement").textContent = `${progressLabel}. ${state.title}`;
  const progress = document.getElementById("reader-progress");
  progress.setAttribute("aria-valuemax", total);
  progress.setAttribute("aria-valuenow", Math.max(1, position));
  progress.setAttribute("aria-valuetext", progressLabel);
  document.getElementById("reader-progress-fill").style.width = `${Math.max(1, position) / total * 100}%`;
  const nextId = nextSceneId();
  document.getElementById("ctrl-next").textContent = nextId ? (state.breaksRule ? 'Repair →' : 'Next →') : 'Finish ✓';
  document.getElementById("ctrl-back").disabled = !previousSceneId();
  if (!autoPlayTimer) document.getElementById("ctrl-play").textContent = nextId ? "▶ Play" : "↻ Replay";
  document.getElementById("reader-hint").textContent = nextId ? '← → to navigate · Space to play or pause · Esc to return' : 'You reached the end of this path. Finish to return to the story.';
  const choicesEl = document.getElementById("stepper-choices");
  choicesEl.innerHTML = "";
  state.steps.forEach(st => {
    const dst = STATE_MAP[st.to];
    const btn = document.createElement("button");
    btn.className = "choice-btn" + (st.bug ? " bug-choice" : "");
    btn.innerHTML = `<strong>${st.bug ? '⚡ ' : ''}${dst.title}</strong><span>${st.label}</span>`;
    btn.addEventListener("click", () => { stopAutoPlay(); activeTour = null; stepToState(st.to); });
    choicesEl.appendChild(btn);
  });
  document.getElementById("path-count").textContent = historyStack.length;
  const trail = document.getElementById("path-trail");
  trail.innerHTML = "";
  historyStack.forEach((item, idx) => {
    const crumb = document.createElement("button");
    crumb.className = "path-crumb";
    crumb.textContent = STATE_MAP[item.stateId].title;
    crumb.title = item.via;
    crumb.addEventListener("click", () => {
      stopAutoPlay(); historyStack = historyStack.slice(0, idx + 1);
      if (activeTour && !activeTour.includes(item.stateId)) activeTour = null;
      stepToState(item.stateId, currentStateId, false);
    });
    trail.appendChild(crumb);
  });
  document.querySelectorAll(".reader-details").forEach(details => { details.open = false; });
  readerBody.scrollTop = 0;
  setReaderLocation();
}
function syncGuardUI() {
  [["guard-mask", guards.causalMask, "Causal mask"], ["guard-clip", guards.gradClip, "Gradient clipping"], ["guard-kl", guards.klLeash, "KL penalty"]].forEach(([id, enabled, label]) => {
    const button = document.getElementById(id);
    button.classList.toggle("broken", !enabled);
    button.setAttribute("aria-pressed", String(enabled));
    button.innerHTML = `${label}: <strong>${enabled ? 'ON' : 'OFF'}</strong>`;
  });
  const badge = document.getElementById("tlc-status-badge");
  const allOk = guards.causalMask && guards.gradClip && guards.klLeash;
  badge.style.color = allOk ? "#8ce09a" : "#ff9b9e";
  badge.textContent = allOk ? "✓ All 3 demonstration guards enabled" : "⚡ Modelled failure path active";
}
[["guard-mask", "causalMask", "s4", "s5"], ["guard-clip", "gradClip", "s9", "s8"], ["guard-kl", "klLeash", "s13", "s12"]].forEach(([id, key, healthy, failure]) => {
  document.getElementById(id).addEventListener("click", () => {
    stopAutoPlay(); activeTour = null; guards[key] = !guards[key];
    stepToState(guards[key] ? healthy : failure);
  });
});
function stopAutoPlay() {
  clearTimeout(autoPlayTimer);
  autoPlayTimer = null;
  const button = document.getElementById("ctrl-play");
  button.classList.remove("playing");
  button.setAttribute("aria-pressed", "false");
  button.textContent = nextSceneId() ? "▶ Play" : "↻ Replay";
}
function queueAutoStep() {
  // Allow a scene to be read; never move the underlying page during playback.
  const words = STATE_MAP[currentStateId].desc.split(/\s+/).length;
  const animationMs = window.LLMScenes.durations[STATE_MAP[currentStateId].artType] * 1000;
  const delay = Math.max(animationMs * .95, Math.min(12000, Math.max(6500, words * 220)));
  autoPlayTimer = setTimeout(() => {
    const next = nextSceneId();
    if (!next) { stopAutoPlay(); return; }
    stepToState(next);
    if (!nextSceneId()) stopAutoPlay(); else queueAutoStep();
  }, delay);
}
function toggleAutoPlay() {
  if (autoPlayTimer) { stopAutoPlay(); return; }
  if (!nextSceneId()) {
    const route = activeTour || HEALTHY_ORDER;
    historyStack = [{stateId: route[0], via: "Replay"}];
    stepToState(route[0], null, false);
  }
  const button = document.getElementById("ctrl-play");
  button.classList.add("playing");
  button.setAttribute("aria-pressed", "true");
  button.textContent = "Ⅱ Pause";
  sceneStartedAt = performance.now();
  queueAutoStep();
}
function runGuidedTour(pathIds) {
  guards.causalMask = guards.gradClip = guards.klLeash = true;
  openReader(pathIds[0], document.activeElement, pathIds);
}
function goPrevious() {
  stopAutoPlay();
  const previous = previousSceneId();
  if (!previous) return;
  if (historyStack.length > 1) { historyStack.pop(); stepToState(previous, currentStateId, false); }
  else { historyStack = [{stateId: previous, via: "Previous scene"}]; stepToState(previous, currentStateId, false); }
}
function goNext() {
  stopAutoPlay();
  const next = nextSceneId();
  if (next) stepToState(next); else closeReader();
}
document.getElementById("ctrl-back").addEventListener("click", goPrevious);
document.getElementById("ctrl-next").addEventListener("click", goNext);
document.getElementById("ctrl-play").addEventListener("click", toggleAutoPlay);
document.getElementById("ctrl-reset").addEventListener("click", () => runGuidedTour(HEALTHY_ORDER));
document.getElementById("btn-start-stepper").addEventListener("click", () => runGuidedTour(HEALTHY_ORDER));
document.getElementById("btn-tour-mask").addEventListener("click", () => runGuidedTour(["s0", "s2", "s3", "s5"]));
document.getElementById("btn-tour-nan").addEventListener("click", () => runGuidedTour(["s0", "s2", "s3", "s4", "s6", "s7", "s8"]));
document.getElementById("btn-tour-reward").addEventListener("click", () => runGuidedTour(["s0", "s2", "s3", "s4", "s6", "s7", "s9", "s10", "s11", "s12"]));
reader.addEventListener("keydown", e => {
  if (e.target.closest("input, textarea, select")) return;
  if (e.key === "ArrowRight") { e.preventDefault(); goNext(); }
  if (e.key === "ArrowLeft") { e.preventDefault(); goPrevious(); }
  if (e.code === "Space" && !e.target.closest("button, summary, a")) { e.preventDefault(); toggleAutoPlay(); }
