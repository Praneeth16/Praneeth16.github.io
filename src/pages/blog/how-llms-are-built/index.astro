---
import { workshop, engine, cluster, serving } from '../../../lib/llm-art.mjs';
import '../../../styles/llm-story.css';
const title = 'How a language model is made';
const description = 'An illustrated, interactive field guide to how LLMs are built. Follow data through tokenization, attention, pretraining, post-training, evaluation, and inference.';
const chapters = [['data','The corpus'],['tokens','The codebook'],['transformer','The engine'],['learning','Learning'],['scale','The cluster'],['assistant','The assistant'],['preferences','Feedback'],['evaluation','The checkpoint'],['inference','The answer']];
---
<!doctype html>
