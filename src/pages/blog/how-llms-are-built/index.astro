function switchPerspective(viewId) {
  if (viewId !== "view-chart") stopAutoPlay();
  document.getElementById("stepper").classList.toggle("perspective-hidden", viewId !== "view-chart");
  document.querySelectorAll(".mode-tab").forEach(tab => {
    const active = tab.getAttribute("data-view") === viewId;
    tab.classList.toggle("active", active);
    tab.setAttribute("aria-selected", active ? "true" : "false");
  });
  document.querySelectorAll(".view-section").forEach(sec => {
    sec.classList.toggle("active", sec.id === viewId);
  });
  if (viewId === "view-chart") {
    setTimeout(() => {
      drawStaticWallEdges();
      updateSpotlightAndRoute(prevStateId, currentStateId, STATE_MAP[currentStateId].breaksRule);
    }, 50);
  }
}

