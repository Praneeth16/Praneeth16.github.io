const STATE_MAP = Object.fromEntries(STATES.map(s => [s.id, s]));

/* ============================================================================
   2. OAV-STYLE HAND-DRAWN PENCIL, PASTEL & GEL PEN ENGINE
      - 4-Frame Wobble Loop: frame sequence [0, 1, 2, 1] every 180ms
      - Deterministic noise jitter so lines shimmer like hand-inked animation
   ============================================================================ */
function mulberry32(seed) {
  let a = seed >>> 0;
  return function() {
    a |= 0; a = (a + 0x6D2B79F5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

function handLine(ctx, x1, y1, x2, y2, color, width, wobbleSeed, wobbleAmp = 1.35) {
  const rng = mulberry32(wobbleSeed);
  const dist = Math.hypot(x2 - x1, y2 - y1);
  const segs = Math.max(3, Math.min(18, Math.floor(dist / 14)));
  ctx.save();
  ctx.strokeStyle = color;
  ctx.lineWidth = width;
  ctx.lineCap = "round";
  ctx.lineJoin = "round";
  // Two-pass simulated pencil/gel stroke
  for (let pass = 0; pass < 2; pass++) {
    ctx.globalAlpha = pass === 0 ? 0.92 : 0.42;
    ctx.beginPath();
    for (let i = 0; i <= segs; i++) {
      const t = i / segs;
      const env = Math.sin(Math.PI * t);
      const jx = (rng() - 0.5) * 2 * wobbleAmp * env;
      const jy = (rng() - 0.5) * 2 * wobbleAmp * env;
      const px = x1 + (x2 - x1) * t + jx;
      const py = y1 + (y2 - y1) * t + jy;
      if (i === 0) ctx.moveTo(px, py);
      else ctx.lineTo(px, py);
    }
    ctx.stroke();
  }
  ctx.restore();
}

function handCircle(ctx, cx, cy, r, strokeColor, fillColor, width, wobbleSeed, wobbleAmp = 1.2) {
  const rng = mulberry32(wobbleSeed);
  const steps = 24;
  ctx.save();
  ctx.beginPath();
  for (let i = 0; i <= steps; i++) {
    const a = (i / steps) * Math.PI * 2;
    const rad = r + (rng() - 0.5) * 2 * wobbleAmp;
    const x = cx + Math.cos(a) * rad;
    const y = cy + Math.sin(a) * rad;
    if (i === 0) ctx.moveTo(x, y);
    else ctx.lineTo(x, y);
  }
  ctx.closePath();
  if (fillColor) {
    ctx.fillStyle = fillColor;
    ctx.fill();
  }
  if (strokeColor) {
    ctx.strokeStyle = strokeColor;
    ctx.lineWidth = width;
    ctx.stroke();
  }
  ctx.restore();
}

function handRect(ctx, x, y, w, h, strokeColor, fillColor, width, wobbleSeed, wobbleAmp = 1.1) {
  const rng = mulberry32(wobbleSeed);
  ctx.save();
  if (fillColor) {
    ctx.fillStyle = fillColor;
    ctx.beginPath();
    ctx.moveTo(x + (rng()-0.5)*wobbleAmp, y + (rng()-0.5)*wobbleAmp);
    ctx.lineTo(x + w + (rng()-0.5)*wobbleAmp, y + (rng()-0.5)*wobbleAmp);
    ctx.lineTo(x + w + (rng()-0.5)*wobbleAmp, y + h + (rng()-0.5)*wobbleAmp);
    ctx.lineTo(x + (rng()-0.5)*wobbleAmp, y + h + (rng()-0.5)*wobbleAmp);
    ctx.closePath();
    ctx.fill();
  }
  if (strokeColor) {
    handLine(ctx, x, y, x + w, y, strokeColor, width, wobbleSeed + 1, wobbleAmp);
    handLine(ctx, x + w, y, x + w, y + h, strokeColor, width, wobbleSeed + 2, wobbleAmp);
    handLine(ctx, x + w, y + h, x, y + h, strokeColor, width, wobbleSeed + 3, wobbleAmp);
    handLine(ctx, x, y + h, x, y, strokeColor, width, wobbleSeed + 4, wobbleAmp);
  }
  ctx.restore();
}

function drawPaperTooth(ctx, w, h, bgColor, frameIdx) {
  ctx.fillStyle = bgColor;
  ctx.fillRect(0, 0, w, h);
  const rng = mulberry32(900 + frameIdx * 17);
  ctx.save();
  for (let i = 0; i < 65; i++) {
    const x = rng() * w;
    const y = rng() * h;
    const len = 6 + rng() * 18;
    ctx.strokeStyle = i % 2 === 0 ? "rgba(255,255,255,0.08)" : "rgba(0,0,0,0.09)";
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(x, y);
    ctx.lineTo(x + len, y + (rng() - 0.5) * 4);
    ctx.stroke();
  }
  ctx.restore();
}

