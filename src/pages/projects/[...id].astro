---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description} article>
  <article>
    <header class="project-header container">
      <p class="eyebrow">{entry.data.status} · {entry.data.year}</p>
      <h1>{entry.data.title}</h1>
      <p class="deck">{entry.data.description}</p>
      <ul class="pill-list">
        {entry.data.tags.map((tag) => <li class="pill">{tag}</li>)}
      </ul>
      <div class="actions">
        {entry.data.githubUrl && <a class="primary" href={entry.data.githubUrl}>View source ↗</a>}
        {entry.data.demoUrl && <a href={entry.data.demoUrl}>Open demo ↗</a>}
      </div>
    </header>
    <div class="project-rule container"></div>
    <div class="prose"><Content /></div>
    <div class="back container"><a class="text-link" href="/projects/">Back to all projects</a></div>
  </article>
</BaseLayout>

<style>
  .project-header {
    width: min(var(--reading), calc(100vw - 40px));
    padding: 3.5rem 0 2rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 2.8rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.8rem, 4.5vw, 2.8rem);
    font-weight: 550;
    letter-spacing: -0.04em;
    line-height: 1.15;
  }

  .deck {
    max-width: 760px;
    margin: 1rem 0;
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .actions {
    display: flex;
    gap: 1.5rem;
    margin-top: 1.2rem;
    align-items: center;
    font-size: 0.72rem;
  }

  .actions .primary {
    padding: 0.4rem 0.65rem;
    color: white;
    background: var(--accent);
    text-decoration: none;
  }

  .project-rule {
    display: none;
  }

  .back {
    max-width: 720px;
    width: min(var(--reading), calc(100vw - 40px));
    padding: 2.5rem 0 4rem;
  }
</style>
