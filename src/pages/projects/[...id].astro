---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description} article>
  <article>
    <header class="project-header container">
      <p class="eyebrow">{entry.data.status} · {entry.data.year}</p>
      <h1>{entry.data.title}</h1>
      <p class="deck">{entry.data.description}</p>
      <ul class="pill-list">
        {entry.data.tags.map((tag) => <li class="pill">{tag}</li>)}
      </ul>
      <div class="actions">
        {entry.data.githubUrl && <a class="primary" href={entry.data.githubUrl}>View source ↗</a>}
        {entry.data.demoUrl && <a href={entry.data.demoUrl}>Open demo ↗</a>}
      </div>
    </header>
    <div class="project-rule container"></div>
    <div class="prose"><Content /></div>
    <div class="back container"><a class="text-link" href="/projects/">Back to all projects</a></div>
  </article>
</BaseLayout>

<style>
  .project-header {
    max-width: 980px;
    padding: 6rem 0 3.5rem;
  }

  h1 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(3.6rem, 8vw, 7.5rem);
    font-weight: 520;
    letter-spacing: -0.05em;
    line-height: 0.92;
  }

  .deck {
    max-width: 760px;
    margin: 2rem 0;
    color: var(--ink-soft);
    font-family: var(--serif);
    font-size: 1.4rem;
  }

  .actions {
    display: flex;
    gap: 1.5rem;
    margin-top: 2rem;
    align-items: center;
    font-size: 0.84rem;
    font-weight: 700;
  }

  .actions .primary {
    padding: 0.75rem 0.95rem;
    color: var(--paper-soft);
    background: var(--ink);
    text-decoration: none;
  }

  .project-rule {
    height: 1px;
    margin-bottom: 5rem;
    background: var(--ink);
  }

  .back {
    max-width: 720px;
    padding: 5rem 0 6rem;
  }
</style>
