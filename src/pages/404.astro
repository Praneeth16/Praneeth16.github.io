---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section class="not-found container">
    <p class="eyebrow">404 · missing trace</p>
    <h1>Page not found.</h1>
    <p>The link may be old, or the note may have moved.</p>
    <a class="text-link" href="/">Return home</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 55vh;
    padding: 4rem 0;
  }

  h1 {
    max-width: 850px;
    margin: 0 0 1.5rem;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 550;
    letter-spacing: -0.04em;
    line-height: 1.15;
  }

  p:not(.eyebrow) {
    color: var(--ink-soft);
    font-size: 1.1rem;
  }
</style>
