---
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/writing/', label: 'Writing' },
  { href: '/projects/', label: 'Projects' },
  { href: '/resume/', label: 'Resume' },
  { href: '/about/', label: 'About' },
  { href: '/rss.xml', label: 'RSS' },
];

const isActive = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="header-inner container">
    <a class="site-title" href="/">Praneeth Paikray</a>
    <p>AI systems, field notes, and workshop material.</p>

    <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav">
      Menu
    </button>

    <nav id="site-nav" aria-label="Primary navigation">
      {links.map((link) => (
        <a class:list={{ active: isActive(link.href) }} href={link.href}>
          {isActive(link.href) && <span aria-hidden="true">&gt; </span>}{link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-button');
  const nav = document.querySelector<HTMLElement>('#site-nav');

  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('open', !open);
  });
</script>

<style>
  .site-header {
    padding: 4rem 0 0;
  }

  .header-inner {
    position: relative;
  }

  .site-title {
    display: inline-block;
    color: var(--accent);
    font-size: clamp(1.45rem, 3vw, 2rem);
    font-weight: 650;
    letter-spacing: -0.04em;
  }

  .site-title:hover {
    text-decoration: none;
  }

  .header-inner > p {
    margin: 0.25rem 0 2rem;
    color: var(--ink-faint);
    font-family: var(--sans);
    font-size: 0.78rem;
  }

  nav {
    display: flex;
    gap: 1.7rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--rule-dark);
  }

  nav a {
    color: var(--ink-soft);
    font-size: 0.78rem;
  }

  nav a:hover,
  nav a.active {
    color: var(--ink);
    text-decoration: none;
  }

  nav a.active span {
    color: var(--accent);
  }

  .menu-button {
    display: none;
  }

  @media (max-width: 560px) {
    .site-header {
      padding-top: 2.5rem;
    }

    .header-inner > p {
      margin-right: 4rem;
      margin-bottom: 1.2rem;
    }

    .menu-button {
      position: absolute;
      top: 0;
      right: 0;
      display: block;
      padding: 0.35rem 0.55rem;
      color: var(--ink-soft);
      border: 1px solid var(--rule);
      background: var(--surface);
      font-size: 0.72rem;
    }

    nav {
      display: none;
      gap: 0.75rem;
      padding: 0.8rem 0;
      border-top: 1px solid var(--rule);
      flex-direction: column;
    }

    nav.open {
      display: flex;
    }
  }
</style>
