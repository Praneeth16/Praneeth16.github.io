---
const path = Astro.url.pathname;
const links = [
  { href: '/writing/', label: 'Writing' },
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
];
---

<header class="site-header">
  <div class="header-inner container">
    <a class="brand" href="/" aria-label="Praneeth Paikray, home">
      <span class="brand-mark">PP</span>
      <span class="brand-name">Praneeth Paikray</span>
    </a>

    <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav">
      Menu
    </button>

    <nav id="site-nav" aria-label="Primary navigation">
      {links.map((link) => (
        <a class:list={{ active: path.startsWith(link.href) }} href={link.href}>{link.label}</a>
      ))}
      <a class="nav-rss" href="/rss.xml">RSS</a>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-button');
  const nav = document.querySelector<HTMLElement>('#site-nav');

  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('open', !open);
  });
</script>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    border-bottom: 1px solid var(--rule);
  }

  .header-inner {
    display: flex;
    min-height: 76px;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: inline-flex;
    gap: 0.75rem;
    align-items: center;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    color: var(--paper-soft);
    border-radius: 50%;
    background: var(--accent);
    font-family: var(--serif);
    font-size: 0.85rem;
  }

  .brand-name {
    font-family: var(--serif);
    font-size: 1.05rem;
    font-weight: 600;
  }

  nav {
    display: flex;
    gap: 1.8rem;
    align-items: center;
  }

  nav a {
    color: var(--ink-soft);
    font-size: 0.84rem;
    font-weight: 650;
    text-decoration: none;
  }

  nav a:hover,
  nav a.active {
    color: var(--ink);
  }

  nav a.active {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.35rem;
  }

  .nav-rss {
    padding-left: 1.8rem;
    border-left: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 0.72rem;
  }

  .menu-button {
    display: none;
    padding: 0.45rem 0.65rem;
    color: var(--ink);
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: transparent;
  }

  @media (max-width: 680px) {
    .brand-name {
      display: none;
    }

    .menu-button {
      display: inline-flex;
    }

    nav {
      position: absolute;
      top: 76px;
      right: 0;
      left: 0;
      display: none;
      padding: 1.2rem 24px 1.5rem;
      border-bottom: 1px solid var(--rule);
      background: var(--paper);
      flex-direction: column;
      align-items: flex-start;
    }

    nav.open {
      display: flex;
    }

    .nav-rss {
      padding: 0;
      border: 0;
    }
  }
</style>
