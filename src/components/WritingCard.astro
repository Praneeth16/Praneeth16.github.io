---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'writing'>;
  featured?: boolean;
}

const { entry } = Astro.props;
const { title, description, kind, tags, readingMinutes, publishedAt, externalUrl } = entry.data;
const url = externalUrl ?? `/writing/${entry.id}/`;
const date = publishedAt.toLocaleDateString('en-IN', { month: 'short', year: 'numeric' });
const kindLabel = kind === 'essay' ? 'essay' : kind === 'note' ? 'note' : 'workshop';
---

<article class="writing-card" data-kind={kind} data-search={`${title} ${description} ${tags.join(' ')}`.toLowerCase()}>
  <div class="card-meta">
    <span>{date}</span>
    <span>{kindLabel}</span>
    <span>{readingMinutes} min</span>
  </div>
  <div class="card-copy">
    <h3><a href={url}>{title}</a></h3>
    <p>{description}</p>
    <ul class="pill-list">
      {tags.slice(0, 4).map((tag) => <li class="pill">{tag}</li>)}
    </ul>
  </div>
</article>

<style>
  .writing-card {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: 1.2rem;
    padding: 1rem 0;
    border-top: 1px solid var(--rule);
  }

  .card-meta {
    display: grid;
    height: max-content;
    gap: 0.1rem;
    color: var(--ink-faint);
    font-size: 0.64rem;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .card-meta span:nth-child(2) {
    color: var(--warm);
  }

  h3 {
    margin: 0 0 0.25rem;
    font-size: 0.92rem;
    font-weight: 550;
    line-height: 1.45;
  }

  p {
    max-width: 690px;
    margin: 0 0 0.45rem;
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  @media (max-width: 560px) {
    .writing-card {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }

    .card-meta {
      display: flex;
      gap: 0.8rem;
    }
  }
</style>
