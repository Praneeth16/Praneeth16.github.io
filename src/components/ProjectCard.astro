---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
  index?: number;
}

const { entry } = Astro.props;
const { title, description, status, year, tags, githubUrl, demoUrl } = entry.data;
---

<article class="project-card">
  <div class="project-meta">
    <span>{year}</span>
    <span>{status}</span>
  </div>
  <div class="project-body">
    <h3><a href={`/projects/${entry.id}/`}>{title}</a></h3>
    <p>{description}</p>
    <ul class="pill-list">
      {tags.map((tag) => <li class="pill">{tag}</li>)}
    </ul>
  </div>
  <div class="project-links">
    {githubUrl && <a href={githubUrl}>code ↗</a>}
    {demoUrl && <a href={demoUrl}>demo ↗</a>}
  </div>
</article>

<style>
  .project-card {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) auto;
    gap: 1rem 1.2rem;
    padding: 1rem 0;
    border-top: 1px solid var(--rule);
  }

  .project-meta {
    display: grid;
    height: max-content;
    color: var(--ink-faint);
    font-size: 0.64rem;
    text-transform: uppercase;
  }

  .project-meta span:last-child {
    color: var(--warm);
  }

  h3 {
    margin: 0 0 0.25rem;
    font-size: 0.92rem;
    font-weight: 550;
  }

  p {
    max-width: 650px;
    margin: 0 0 0.45rem;
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .project-links {
    display: flex;
    gap: 0.8rem;
    align-items: start;
    font-size: 0.68rem;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .project-card {
      grid-template-columns: 1fr auto;
    }

    .project-meta {
      display: flex;
      gap: 0.8rem;
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 440px) {
    .project-card {
      grid-template-columns: 1fr;
    }
  }
</style>
