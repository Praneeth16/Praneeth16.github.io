---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  article?: boolean;
}

const {
  title = 'Praneeth Paikray | AI systems, measured and explained',
  description = 'Production AI systems, agent evaluation, open-source experiments, technical essays, and workshops by Praneeth Paikray.',
  canonical = Astro.url.pathname,
  article = false,
} = Astro.props;
const fullTitle = article || title.startsWith('Praneeth') ? title : `${title} | Praneeth Paikray`;
const canonicalUrl = new URL(canonical, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fdfcfb" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Praneeth Paikray" href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image" content="https://praneeth16.github.io/jev/og.png" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
  </body>
</html>
