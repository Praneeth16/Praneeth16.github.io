---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  kind: 'essay' | 'note' | 'workshop';
  publishedAt: Date;
  updatedAt?: Date;
  readingMinutes: number;
  tags: string[];
  externalUrl?: string;
}

const { title, description, kind, publishedAt, updatedAt, readingMinutes, tags, externalUrl } = Astro.props;
const label = kind === 'essay' ? 'Technical essay' : kind === 'note' ? 'Research note' : 'Workshop notes';
const formatDate = (date: Date) => date.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title={title} description={description} canonical={Astro.url.pathname} article>
  <article>
    <header class="article-header container">
      <p class="eyebrow">{label}</p>
      <h1>{title}</h1>
      <p class="deck">{description}</p>
      <div class="article-meta">
        <span>{formatDate(publishedAt)}</span>
        {updatedAt && <span>updated {formatDate(updatedAt)}</span>}
        <span>{readingMinutes} min read</span>
      </div>
      <ul class="pill-list">
        {tags.map((tag) => <li class="pill">{tag}</li>)}
      </ul>
      {externalUrl && <a class="medium-link" href={externalUrl}>Read the published version on Medium ↗</a>}
    </header>
    <div class="prose"><slot /></div>
    <aside class="article-end container">
      <span aria-hidden="true">&lt;</span>
      <a href="/writing/">Back to all writing</a>
    </aside>
  </article>
</BaseLayout>

<style>
  .article-header {
    width: min(var(--reading), calc(100vw - 40px));
    padding: 3.5rem 0 2.3rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 2.8rem;
  }

  h1 {
    max-width: 720px;
    margin: 0;
    font-size: clamp(1.8rem, 4.5vw, 2.8rem);
    font-weight: 550;
    letter-spacing: -0.04em;
    line-height: 1.15;
  }

  .deck {
    max-width: 670px;
    margin: 1rem 0 1.2rem;
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-bottom: 0.35rem;
    color: var(--ink-faint);
    font-size: 0.67rem;
    text-transform: uppercase;
  }

  .medium-link {
    display: inline-block;
    margin-top: 0.85rem;
    font-size: 0.7rem;
  }

  .article-end {
    display: flex;
    width: min(var(--reading), calc(100vw - 40px));
    gap: 0.45rem;
    padding: 2.5rem 0 4rem;
    font-size: 0.75rem;
  }

  .article-end span {
    color: var(--warm);
  }
</style>
