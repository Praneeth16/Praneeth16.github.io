---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  kind: 'essay' | 'note' | 'workshop';
  publishedAt: Date;
  updatedAt?: Date;
  readingMinutes: number;
  tags: string[];
}

const { title, description, kind, publishedAt, updatedAt, readingMinutes, tags } = Astro.props;
const label = kind === 'essay' ? 'Technical essay' : kind === 'note' ? 'Research note' : 'Workshop notes';
const formatDate = (date: Date) => date.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title={title} description={description} canonical={Astro.url.pathname} article>
  <article>
    <header class="article-header container">
      <p class="eyebrow">{label}</p>
      <h1>{title}</h1>
      <p class="deck">{description}</p>
      <div class="article-meta">
        <span>{formatDate(publishedAt)}</span>
        {updatedAt && <span>Updated {formatDate(updatedAt)}</span>}
        <span>{readingMinutes} min read</span>
      </div>
      <ul class="pill-list">
        {tags.map((tag) => <li class="pill">{tag}</li>)}
      </ul>
    </header>
    <div class="article-rule container"></div>
    <div class="prose"><slot /></div>
    <aside class="article-end container">
      <p class="eyebrow">Keep exploring</p>
      <p>More field notes on building, evaluating, and operating AI systems.</p>
      <a class="text-link" href="/writing/">Browse all writing</a>
    </aside>
  </article>
</BaseLayout>

<style>
  .article-header {
    max-width: 980px;
    padding: 6.5rem 0 3.5rem;
  }

  h1 {
    max-width: 930px;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(3.2rem, 7vw, 6.6rem);
    font-weight: 520;
    letter-spacing: -0.05em;
    line-height: 0.96;
  }

  .deck {
    max-width: 720px;
    margin: 2rem 0 2.2rem;
    color: var(--ink-soft);
    font-family: var(--serif);
    font-size: 1.35rem;
    line-height: 1.5;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
    margin-bottom: 1rem;
    color: var(--ink-faint);
    font-family: var(--mono);
    font-size: 0.72rem;
  }

  .article-rule {
    height: 1px;
    margin-bottom: 5rem;
    background: var(--ink);
  }

  .article-end {
    max-width: 720px;
    margin-top: 5.5rem;
    margin-bottom: 6rem;
    padding: 2rem;
    border: 1px solid var(--rule);
    background: var(--paper-soft);
  }

  .article-end p:not(.eyebrow) {
    max-width: 560px;
    font-family: var(--serif);
    font-size: 1.45rem;
    line-height: 1.35;
  }

  @media (max-width: 760px) {
    .article-header {
      padding-top: 4.5rem;
    }

    .article-rule {
      margin-bottom: 3.5rem;
    }
  }
</style>
