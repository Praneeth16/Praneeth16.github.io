[{"name": "01-fast-and-slow", "elements": [{"type": "text", "id": "01-fast-and-slow-1", "roughness": 0.5, "strokeColor": "#292c2b", "strokeWidth": 1.5, "seed": 20260927, "x": 30, "y": 10, "text": "Split the work by how much thinking it needs.", "fontSize": 25, "fontFamily": 1}, {"type": "rectangle", "id": "01-fast-and-slow-2", "roughness": 0.5, "strokeColor": "#4b7864", "strokeWidth": 1.5, "seed": 20260928, "x": 40, "y": 110, "width": 340, "height": 90, "backgroundColor": "#4b7864", "fillStyle": "solid", "roundness": {"type": 3}, "label": {"text": "System 1: decide", "fontSize": 22, "fontFamily": 2, "strokeColor": "#ffffff"}}, {"type": "text", "id": "01-fast-and-slow-3", "roughness": 0.5, "strokeColor": "#292c2b", "strokeWidth": 1.5, "seed": 20260929, "x": 48, "y": 220, "text": "Fast, automatic, bounded.\nPick from options you defined.\nReturn a probability for each.", "fontSize": 20, "fontFamily": 1}, {"type": "rectangle", "id": "01-fast-and-slow-4", "roughness": 0.5, "strokeColor": "#80658f", "strokeWidth": 1.5, "seed": 20260930, "x": 620, "y": 110, "width": 340, "height": 90, "backgroundColor": "#80658f", "fillStyle": "solid", "roundness": {"type": 3}, "label": {"text": "System 2: deliberate", "fontSize": 22, "fontFamily": 2, "strokeColor": "#ffffff"}}, {"type": "text", "id": "01-fast-and-slow-5", "roughness": 0.5, "strokeColor": "#292c2b", "strokeWidth": 1.5, "seed": 20260931, "x": 628, "y": 220, "text": "Slow, effortful, open-ended.\nReason in tokens, write text,\ncall tools, plan.", "fontSize": 20, "fontFamily": 1}, {"type": "text", "id": "01-fast-and-slow-6", "roughness": 0.5, "strokeColor": "#666b68", "strokeWidth": 1.5, "seed": 20260932, "x": 48, "y": 345, "text": "Jev, Laya, a fine-tuned classifier", "fontSize": 19, "fontFamily": 1}, {"type": "text", "id": "01-fast-and-slow-7", "roughness": 0.5, "strokeColor": "#666b68", "strokeWidth": 1.5, "seed": 20260933, "x": 628, "y": 345, "text": "Reasoning LLMs such as GPT-6 Sol", "fontSize": 19, "fontFamily": 1}, {